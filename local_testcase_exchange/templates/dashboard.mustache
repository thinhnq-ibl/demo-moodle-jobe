{{! Student and teacher dashboard for private runs, contributions and rewards. }}
{{#show_course_switcher}}
<div class="card bg-light mb-3 p-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <span class="text-muted mr-1">📚 {{#str}} course {{/str}}:</span>
            <strong>{{current_course_name}}</strong>
            <a href="{{course_hub_url}}" class="badge badge-secondary ml-2">&larr; {{#str}} allcourses, local_testcase_exchange {{/str}}</a>
        </div>
        <div class="d-flex align-items-center mt-1 mt-md-0">
            <label for="switchCourseSelect" class="small text-muted mb-0 mr-2">{{#str}} switchcourse, local_testcase_exchange {{/str}}:</label>
            <select id="switchCourseSelect" class="custom-select custom-select-sm" onchange="if (this.value) window.location.href=this.value;">
                {{#available_courses}}
                <option value="{{switch_url}}" {{#is_current}}selected{{/is_current}}>{{shortname}} - {{fullname}}</option>
                {{/available_courses}}
            </select>
        </div>
    </div>
</div>
{{/show_course_switcher}}

{{#has_return_url}}
<div class="mb-3 d-flex align-items-center">
    <a class="btn btn-outline-secondary font-weight-bold" href="{{return_url}}">
        &larr; {{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}{{#return_quiz_name}}: <strong>{{return_quiz_name}}</strong>{{/return_quiz_name}}
    </a>
</div>
{{/has_return_url}}

{{#can_manage_or_review}}
<div class="mb-3 d-flex flex-wrap align-items-center">
    {{#can_manage}}<a class="btn btn-secondary mr-2 mb-2" href="{{policy_url}}">{{#str}} managepolicies, local_testcase_exchange {{/str}}</a>{{/can_manage}}
    {{#can_review}}<a class="btn btn-primary mr-2 mb-2" href="{{review_url}}">{{#str}} reviewcontributions, local_testcase_exchange {{/str}} <span class="badge badge-light ml-1">{{pending_contribution_count}}</span></a>{{/can_review}}
</div>
{{/can_manage_or_review}}
{{#can_run}}
<div class="card mb-4"><div class="card-header"><strong>{{#str}} privateexploration, local_testcase_exchange {{/str}}</strong></div><div class="card-body">
{{#has_return_url}}<a class="btn btn-secondary mb-3" href="{{return_url}}">{{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}</a>{{/has_return_url}}
{{^has_questions}}<div class="alert alert-warning">{{#str}} nocoderunnerquestions, local_testcase_exchange {{/str}}</div>{{/has_questions}}
{{#has_questions}}{{#show_run_form}}
{{#use_attempt_context}}
<div class="alert alert-primary" role="status">
    <strong>{{#str}} contributingtestcasefor, local_testcase_exchange {{/str}}</strong>
    <div><strong>{{#str}} currentquiz, local_testcase_exchange {{/str}}:</strong> {{current_quiz_name}}</div>
    <div><strong>{{#str}} currentquestion, local_testcase_exchange {{/str}}:</strong> {{current_question_name}}</div>
</div>
{{/use_attempt_context}}
<form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="run">
{{#use_attempt_context}}<input type="hidden" name="question" value="{{selected_question_value}}"><input type="hidden" name="student_code" value="{{student_code}}">{{/use_attempt_context}}
{{^use_attempt_context}}
<div class="form-group"><label for="question"><strong>{{#str}} selectquestion, local_testcase_exchange {{/str}}</strong></label><select class="form-control" id="question" name="question" required>{{#questions}}<option value="{{value}}" {{#disabled}}disabled{{/disabled}} {{#selected}}selected{{/selected}}>{{label}}</option>{{/questions}}</select></div>
{{#show_code_editor}}
<div class="form-group"><label for="student_code"><strong>{{#str}} studentsource, local_testcase_exchange {{/str}}</strong></label><textarea class="form-control" id="student_code" name="student_code" rows="10" required>{{student_code}}</textarea></div>
{{/show_code_editor}}
{{/use_attempt_context}}
<div class="row"><div class="col-md-6 form-group"><label for="test_input"><strong>{{#str}} testinput, local_testcase_exchange {{/str}}</strong></label><textarea class="form-control" id="test_input" name="test_input" rows="4" required></textarea></div><div class="col-md-6 form-group"><label for="predicted_output"><strong>{{#str}} predictedoutput, local_testcase_exchange {{/str}}</strong></label><textarea class="form-control" id="predicted_output" name="predicted_output" rows="4"></textarea></div></div>
{{^use_attempt_context}}
<div class="row"><div class="col-md-4 form-group"><label for="category">{{#str}} category, local_testcase_exchange {{/str}}</label><select class="form-control" id="category" name="category">{{#categories}}<option value="{{value}}">{{label}}</option>{{/categories}}</select></div><div class="col-md-8 form-group"><label for="purpose">{{#str}} purpose, local_testcase_exchange {{/str}}</label><input class="form-control" id="purpose" name="purpose" maxlength="1000"></div></div>
<div class="form-group"><label for="reflection">{{#str}} reflection, local_testcase_exchange {{/str}}</label><input class="form-control" id="reflection" name="reflection" maxlength="1000"></div><button class="btn btn-primary" type="submit">{{#str}} runprivate, local_testcase_exchange {{/str}}</button>
{{/use_attempt_context}}
{{#use_attempt_context}}<button class="btn btn-primary" type="submit">{{#str}} runprivate, local_testcase_exchange {{/str}}</button>{{/use_attempt_context}}
</form>{{/show_run_form}}
{{^show_run_form}}<div class="alert alert-info">{{#str}} submitcodebeforetesting, local_testcase_exchange {{/str}}</div>{{/show_run_form}}
{{/has_questions}}</div></div>
{{/can_run}}
<ul class="nav nav-tabs" role="tablist">
    {{#is_teacher}}
    <li class="nav-item"><a class="nav-link active font-weight-bold" data-toggle="tab" href="#course_contributions">{{#str}} coursecontributions, local_testcase_exchange {{/str}} ({{course_contribution_count}})</a></li>
    {{/is_teacher}}
    <li class="nav-item"><a class="nav-link {{^is_teacher}}active{{/is_teacher}}" data-toggle="tab" href="#runs">{{#str}} myruns, local_testcase_exchange {{/str}} ({{run_count}})</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#contributions">{{#str}} mycontributions, local_testcase_exchange {{/str}} ({{contribution_count}})</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#rewards">{{#str}} myrewards, local_testcase_exchange {{/str}} ({{reward_count}})</a></li>
</ul>
<div class="tab-content border border-top-0 p-3 mb-4">
    {{#is_teacher}}
    <div class="tab-pane active" id="course_contributions">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">{{#str}} coursecontributions, local_testcase_exchange {{/str}}</h5>
            {{#can_review}}<a class="btn btn-sm btn-primary" href="{{review_url}}">{{#str}} reviewcontributions, local_testcase_exchange {{/str}} &rarr;</a>{{/can_review}}
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped table-hover"><thead><tr><th>ID</th><th>{{#str}} student, local_testcase_exchange {{/str}}</th><th>{{#str}} quizquestion, local_testcase_exchange {{/str}}</th><th>{{#str}} testinput, local_testcase_exchange {{/str}}</th><th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} status {{/str}}</th><th>{{#str}} time {{/str}}</th></tr></thead><tbody>
        {{^has_course_contributions}}<tr><td colspan="8" class="text-center text-muted py-3">{{#str}} nocontributionsfound, local_testcase_exchange {{/str}}</td></tr>{{/has_course_contributions}}
        {{#course_contributions}}<tr><td><strong>#{{id}}</strong></td><td><div><strong>{{student_name}}</strong></div><small class="text-muted">{{student_username}}</small></td><td><div><strong>{{quiz_name}}</strong></div><small class="text-muted">{{question_name}}</small></td><td><pre class="mb-0">{{input_normalized}}</pre></td><td><pre class="mb-0">{{oracle_output}}</pre></td><td><span class="badge badge-info">{{category}}</span>{{#purpose}}<br><small class="text-muted">{{purpose}}</small>{{/purpose}}</td><td><span class="{{status_badge_class}}">{{status_label}}</span>{{#has_rating}}<div class="mt-1" title="{{rating_val}}/5 sao"><span class="text-warning font-weight-bold">{{stars_emoji}}</span> <small class="badge badge-warning text-dark">{{rating_val}}/5 ★</small></div>{{/has_rating}}{{#has_teacher_comment}}<div class="small text-muted mt-1 bg-light p-1 rounded border">💬 {{teacher_comment}}</div>{{/has_teacher_comment}}</td><td><small>{{submitted_at}}</small></td></tr>{{/course_contributions}}
        </tbody></table></div>
    </div>
    {{/is_teacher}}
    <div class="tab-pane {{^is_teacher}}active{{/is_teacher}}" id="runs"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Input</th><th>{{#str}} predictedoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} studentoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} status {{/str}}</th><th></th></tr></thead><tbody>{{#runs}}<tr><td>{{id}}</td><td><pre class="mb-0">{{input_raw}}</pre></td><td><pre class="mb-0">{{predicted_output}}</pre></td><td><pre class="mb-0">{{student_run_output}}</pre><small>{{student_outcome}}</small></td><td>{{#show_oracle}}<pre class="mb-0">{{oracle_output}}</pre>{{/show_oracle}}{{^show_oracle}}—{{/show_oracle}}<small>{{oracle_outcome}}</small></td><td>{{display_status}}</td><td>{{#can_contribute}}<form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="contribute"><input type="hidden" name="run_id" value="{{id}}"><button class="btn btn-sm btn-success" type="submit">{{#str}} proposesharing, local_testcase_exchange {{/str}}</button></form>{{/can_contribute}}</td></tr>{{/runs}}</tbody></table></div></div>
    <div class="tab-pane" id="contributions"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Input</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} status {{/str}}</th><th>{{#str}} starrating, local_testcase_exchange {{/str}} / {{#str}} teachercomment, local_testcase_exchange {{/str}}</th><th>{{#str}} time {{/str}}</th></tr></thead><tbody>{{#contributions}}<tr><td>{{id}}</td><td><pre class="mb-0">{{input_normalized}}</pre></td><td>{{category}}</td><td><span class="{{status_badge_class}}">{{status_label}}</span>{{#can_explain}}<form method="post" class="mt-2"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="explain"><input type="hidden" name="contribution_id" value="{{id}}"><input class="form-control form-control-sm mb-1" name="explanation" required><button class="btn btn-sm btn-primary">{{#str}} resubmitexplanation, local_testcase_exchange {{/str}}</button></form>{{/can_explain}}</td><td>{{#has_rating}}<div title="{{rating_val}}/5 sao"><span class="text-warning font-weight-bold">{{stars_emoji}}</span> <span class="badge badge-warning text-dark ml-1">{{rating_val}}/5 ★</span></div>{{/has_rating}}{{^has_rating}}<span class="text-muted small">—</span>{{/has_rating}}{{#has_teacher_comment}}<div class="small text-muted mt-1 bg-light p-1 rounded border">💬 {{teacher_comment}}</div>{{/has_teacher_comment}}</td><td>{{submitted_at}}</td></tr>{{/contributions}}</tbody></table></div></div>
    <div class="tab-pane" id="rewards"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Input</th><th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} time {{/str}}</th></tr></thead><tbody>{{#rewards}}<tr><td>{{id}}</td><td><pre class="mb-0">{{input_normalized}}</pre></td><td><pre class="mb-0">{{oracle_output}}</pre></td><td>{{category}}</td><td>{{created_at}}</td></tr>{{/rewards}}</tbody></table></div></div>
</div>
