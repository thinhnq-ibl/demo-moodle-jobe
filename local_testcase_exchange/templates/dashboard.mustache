    <!-- TAB 5: POLICY CONFIGURATION -->
    <div class="tab-pane {{#tab_policy_active}}active{{/tab_policy_active}}" id="tab_policy">
        <div class="mb-3">
            <h5 class="font-weight-bold text-dark mb-0">{{#str}} tab_policy, local_testcase_exchange {{/str}}</h5>
            <small class="text-muted">Cài đặt chính sách kiểm thử và trao đổi testcase cho: <strong>{{current_quiz_name}}</strong></small>
        </div>

        <form method="post" class="card bg-white p-4 border" style="border-radius: 8px;">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="save_policy">
            <input type="hidden" name="target_quiz_id" value="{{policy.target_quiz_id}}">
            <input type="hidden" name="target_question_id" value="{{policy.target_question_id}}">

            <!-- Nhóm 1: Bật/tắt và phạm vi áp dụng -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3">1. Bật/tắt và phạm vi áp dụng</h6>
            <div class="form-group row align-items-center">
                <label class="col-sm-3 col-form-label font-weight-bold">Trạng thái tính năng:</label>
                <div class="col-sm-9">
                    <div class="custom-control custom-switch">
                        <input type="checkbox" class="custom-control-input" id="policyEnabled" name="enabled" value="1" {{#policy.enabled}}checked{{/policy.enabled}}>
                        <label class="custom-control-label font-weight-bold" for="policyEnabled">Bật trao đổi testcase cho bài quiz này</label>
                    </div>
                </div>
            </div>

            <!-- Nhóm 2: Duyệt đóng góp -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3 mt-4">2. Duyệt đóng góp</h6>
            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">{{#str}} reviewmode, local_testcase_exchange {{/str}}:</label>
                <div class="col-sm-9">
                    <select class="custom-select" name="review_mode">
                        <option value="teacher" {{#policy.review_mode_teacher}}selected{{/policy.review_mode_teacher}}>{{#str}} reviewmode_teacher, local_testcase_exchange {{/str}}</option>
                        <option value="auto" {{#policy.review_mode_auto}}selected{{/policy.review_mode_auto}}>{{#str}} reviewmode_auto, local_testcase_exchange {{/str}}</option>
                    </select>
                </div>
            </div>

            <!-- Nhóm 3: Trao thưởng -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3 mt-4">3. Trao thưởng</h6>
            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">{{#str}} rewardpolicy, local_testcase_exchange {{/str}}:</label>
                <div class="col-sm-9">
                    <select class="custom-select" name="reward_policy">
                        <option value="one_for_one" {{#policy.reward_policy_one_for_one}}selected{{/policy.reward_policy_one_for_one}}>{{#str}} rewardpolicy_oneforone, local_testcase_exchange {{/str}}</option>
                        <option value="disabled" {{#policy.reward_policy_disabled}}selected{{/policy.reward_policy_disabled}}>Tắt trao thưởng tự động</option>
                    </select>
                </div>
            </div>

            <!-- Nhóm 4: Giới hạn chạy thử -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3 mt-4">4. Giới hạn chạy thử</h6>
            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">{{#str}} runsperminute, local_testcase_exchange {{/str}}:</label>
                <div class="col-sm-9">
                    <div class="input-group" style="max-width: 240px;">
                        <input type="number" class="form-control" name="max_runs_per_minute" value="{{policy.max_runs_per_minute}}" min="1" max="120" required>
                        <div class="input-group-append"><span class="input-group-text">lượt/phút</span></div>
                    </div>
                    <small class="form-text text-muted">Bảo vệ hạ tầng Jobe sandbox khỏi tần suất chạy quá dày đặc.</small>
                </div>
            </div>

            <!-- Nhóm 5: Hiển thị -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3 mt-4">5. Tùy chọn hiển thị</h6>
            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">Hiển thị & Bảng xếp hạng:</label>
                <div class="col-sm-9">
                    <div class="custom-control custom-checkbox mb-2">
                        <input type="checkbox" class="custom-control-input" id="policyShowOracle" name="show_oracle_output" value="1" {{#policy.show_oracle_output}}checked{{/policy.show_oracle_output}}>
                        <label class="custom-control-label" for="policyShowOracle">{{#str}} showoracle, local_testcase_exchange {{/str}}</label>
                    </div>
                    <div class="custom-control custom-checkbox">
                        <input type="checkbox" class="custom-control-input" id="policyLeaderboard" name="leaderboard_enabled" value="1" {{#policy.leaderboard_enabled}}checked{{/policy.leaderboard_enabled}}>
                        <label class="custom-control-label" for="policyLeaderboard">{{#str}} enableleaderboard, local_testcase_exchange {{/str}}</label>
                    </div>
                </div>
            </div>

            <!-- Nhóm 6: Cấu hình nâng cao -->
            <h6 class="font-weight-bold text-dark border-bottom pb-2 mb-3 mt-4">6. Cấu hình nâng cao</h6>
            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">{{#str}} maxinputbytes, local_testcase_exchange {{/str}}:</label>
                <div class="col-sm-9">
                    <div class="input-group" style="max-width: 240px;">
                        <input type="number" class="form-control" name="max_input_bytes" value="{{policy.max_input_bytes}}" min="256" max="65536" required>
                        <div class="input-group-append"><span class="input-group-text">bytes</span></div>
                    </div>
                    <small class="form-text text-muted">Kích thước tối đa cho mỗi bộ dữ liệu đầu vào.</small>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">{{#str}} normalization, local_testcase_exchange {{/str}}:</label>
                <div class="col-sm-9">
                    <select class="custom-select" name="normalization_mode" style="max-width: 380px;">
                        <option value="trim" {{#policy.norm_trim}}selected{{/policy.norm_trim}}>Chuẩn hóa cắt khoảng trắng thừa (trim - Khuyên dùng)</option>
                        <option value="raw" {{#policy.norm_raw}}selected{{/policy.norm_raw}}>Giữ nguyên bản không chuẩn hóa (raw)</option>
                    </select>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                <button type="submit" class="btn btn-primary font-weight-bold px-4 py-2 shadow-sm">
                    <i class="fa fa-save mr-1"></i>{{#str}} save_changes_btn, local_testcase_exchange {{/str}}
                </button>
            </div>
        </form>
    </div>
</div>
