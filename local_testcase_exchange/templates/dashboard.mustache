                        <div class="input-group-append"><span class="input-group-text">bytes</span></div>
                    </div>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">Chế độ chuẩn hóa khoảng trắng:</label>
                <div class="col-sm-9">
                    <select class="custom-select" name="normalization_mode">
                        <option value="trim" {{#policy.norm_trim}}selected{{/policy.norm_trim}}>Cắt khoảng trắng đầu cuối mỗi dòng (trim - Khuyên dùng)</option>
                        <option value="raw" {{#policy.norm_raw}}selected{{/policy.norm_raw}}>Nguyên bản không chuẩn hóa (raw)</option>
                    </select>
                </div>
            </div>

            <div class="form-group row">
                <label class="col-sm-3 col-form-label font-weight-bold">Tùy chọn hiển thị & Bảng xếp hạng:</label>
                <div class="col-sm-9">
                    <div class="custom-control custom-checkbox mt-1">
                        <input type="checkbox" class="custom-control-input" id="policyShowOracle" name="show_oracle_output" value="1" {{#policy.show_oracle_output}}checked{{/policy.show_oracle_output}}>
                        <label class="custom-control-label" for="policyShowOracle">Cho phép hiển thị stdout Solution trong màn hình Quản lý của Giáo viên</label>
                    </div>
                    <div class="custom-control custom-checkbox mt-2">
                        <input type="checkbox" class="custom-control-input" id="policyLeaderboard" name="leaderboard_enabled" value="1" {{#policy.leaderboard_enabled}}checked{{/policy.leaderboard_enabled}}>
                        <label class="custom-control-label" for="policyLeaderboard">Bật bảng vinh danh đóng góp (Leaderboard) cho sinh viên</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end mt-3">
                <button type="submit" class="btn btn-primary font-weight-bold px-4 py-2 shadow-sm">
                    💾 Lưu Cấu Hình Chính Sách
                </button>
            </div>
        </form>
    </div>
</div>
