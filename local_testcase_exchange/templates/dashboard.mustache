{{! Student and teacher dashboard for private runs, contributions and rewards. }}
{{#show_course_switcher}}
<div class="card bg-light mb-3 p-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <span class="text-muted mr-1">📚 {{#str}} course {{/str}}:</span>
            <strong>{{current_course_name}}</strong>
            <a href="{{course_hub_url}}" class="badge badge-secondary ml-2">&larr; {{#str}} allcourses, local_testcase_exchange {{/str}}</a>
        </div>
        <div class="d-flex align-items-center mt-1 mt-md-0">
            <label for="switchCourseSelect" class="small text-muted mb-0 mr-2">{{#str}} switchcourse, local_testcase_exchange {{/str}}:</label>
            <select id="switchCourseSelect" class="custom-select custom-select-sm" onchange="if (this.value) window.location.href=this.value;">
                {{#available_courses}}
                <option value="{{switch_url}}" {{#is_current}}selected{{/is_current}}>{{shortname}} - {{fullname}}</option>
                {{/available_courses}}
            </select>
        </div>
    </div>
</div>
{{/show_course_switcher}}

{{#has_return_url}}
<div class="mb-3 d-flex align-items-center">
    <a class="btn btn-outline-secondary font-weight-bold" href="{{return_url}}">
        &larr; {{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}{{#return_quiz_name}}: <strong>{{return_quiz_name}}</strong>{{/return_quiz_name}}
    </a>
</div>
{{/has_return_url}}

{{#can_manage_or_review}}
<div class="mb-3 d-flex flex-wrap align-items-center">
    {{#can_manage}}<a class="btn btn-secondary mr-2 mb-2" href="{{policy_url}}">{{#str}} managepolicies, local_testcase_exchange {{/str}}</a>{{/can_manage}}
    {{#can_review}}<a class="btn btn-primary mr-2 mb-2" href="{{review_url}}">{{#str}} reviewcontributions, local_testcase_exchange {{/str}} <span class="badge badge-light ml-1">{{pending_contribution_count}}</span></a>{{/can_review}}
</div>
{{/can_manage_or_review}}
{{#can_run}}
<div class="card mb-4 border-primary shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <strong>🧪 Phòng Thí Nghiệm Kiểm Thử Vi Sai (Differential Testing Playground)</strong>
        <span class="badge badge-light text-dark">Thử nghiệm tự do — Không tính điểm phạt</span>
    </div>
    <div class="card-body">
        <p class="text-muted small mb-3">
            Tại đây bạn có thể dán mã nguồn chương trình, tự thiết kế testcase và chạy thử nghiệm. Hệ thống sẽ đối chiếu kết quả giữa <strong>Chương trình của bạn</strong> và <strong>Đáp án chuẩn của Thầy/Cô (Solution)</strong> để giúp bạn phát hiện lỗi logic trước khi nộp bài thi Quiz.
        </p>

        {{#has_return_url}}
        <a class="btn btn-outline-secondary btn-sm mb-3" href="{{return_url}}">
            &larr; {{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}
        </a>
        {{/has_return_url}}

        {{^has_questions}}
        <div class="alert alert-warning">{{#str}} nocoderunnerquestions, local_testcase_exchange {{/str}}</div>
        {{/has_questions}}

        {{#has_questions}}
        <form method="post">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="run">

            <div class="form-group mb-3">
                <label for="question"><strong>🎯 {{#str}} selectquestion, local_testcase_exchange {{/str}}:</strong></label>
                <select class="form-control font-weight-bold" id="question" name="question" required>
                    {{#questions}}
                    <option value="{{value}}" {{#disabled}}disabled{{/disabled}} {{#selected}}selected{{/selected}}>{{label}}</option>
                    {{/questions}}
                </select>
            </div>

            {{#has_code_revisions}}
            <!-- Lịch sử Phiên bản Code & Testcase đã thử nghiệm -->
            <div class="card border-info mb-3 bg-light">
                <div class="card-header bg-info text-white py-2 d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <span class="font-weight-bold">🕒 Lịch sử Phiên bản Code & Testcase đã thử nghiệm</span>
                        <span class="badge badge-light text-dark font-weight-bold ml-2">{{code_revisions_count}} phiên bản</span>
                    </div>
                    <div class="my-1">
                        <a href="{{export_timeline_csv_url}}" class="btn btn-sm btn-light text-primary font-weight-bold shadow-sm" title="Xuất dữ liệu dòng thời gian học tập & kiểm thử">
                            📥 Xuất Timeline (CSV)
                        </a>
                        <a href="{{export_timeline_json_url}}" class="btn btn-sm btn-outline-light ml-1" title="Xuất toàn bộ payload dạng JSON">
                            JSON
                        </a>
                    </div>
                </div>
                <div class="card-body p-2">
                    <div class="small text-muted mb-2">
                        Mỗi khi bạn thay đổi mã nguồn, hệ thống tự động ghi nhận phiên bản mới theo mốc thời gian và liên kết các testcase được chạy tương ứng:
                    </div>
                    <div class="list-group list-group-flush">
                        {{#code_revisions}}
                        <div class="list-group-item bg-transparent px-2 py-2 d-flex flex-wrap justify-content-between align-items-center border-bottom">
                            <div class="mr-2 mb-1">
                                <span class="badge badge-primary font-weight-bold p-1">🏷️ Code v{{step_number}}</span>
                                <span class="text-muted small ml-1">Lưu lúc: <strong>{{created_at_formatted}}</strong></span>
                                {{#is_latest}}
                                <span class="badge badge-success ml-1">Mới nhất</span>
                                {{/is_latest}}
                                <div class="mt-1">
                                    <span class="small font-weight-bold text-dark">Testcase liên kết:</span>
                                    {{#has_testcases}}
                                    <span class="badge badge-secondary p-1">{{testcase_ids_string}}</span>
                                    <small class="text-muted">({{testcase_count}} ca)</small>
                                    {{/has_testcases}}
                                    {{^has_testcases}}
                                    <span class="small text-muted font-italic">Chưa chạy testcase nào</span>
                                    {{/has_testcases}}
                                </div>
                            </div>
                            <div>
                                <button type="button" class="btn btn-sm btn-outline-primary font-weight-bold btn-apply-revision" title="Dán mã nguồn của phiên bản này vào khung soạn thảo">
                                    📋 Nạp code v{{step_number}} vào Editor
                                </button>
                                <textarea class="d-none revision-full-code">{{code_content}}</textarea>
                            </div>
                        </div>
                        {{/code_revisions}}
                    </div>
                </div>
            </div>
            {{/has_code_revisions}}

            <!-- Khung soạn thảo / dán mã nguồn sinh viên -->
            <div class="form-group mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1 flex-wrap">
                    <div>
                        <label for="student_code" class="mb-0"><strong>💻 Mã nguồn chương trình của bạn (Student Source Code):</strong></label>
                        <span id="storageStatusBadge" class="small text-muted font-italic ml-2"></span>
                    </div>
                    <small class="text-muted">Code và testcase được tự động lưu trạng thái trên trình duyệt (LocalStorage)</small>
                </div>
                <textarea class="form-control font-monospace text-dark bg-light" id="student_code" name="student_code" rows="7" required placeholder="def tinh_tong(n):&#10;    # Dán mã nguồn Python của bạn vào đây&#10;    pass" style="font-family: Consolas, Monaco, monospace; font-size: 0.95rem;">{{student_code}}</textarea>
            </div>

            <!-- Khung định nghĩa Testcase theo phong cách CodeRunner -->
            <div class="card bg-light border p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                    <h6 class="font-weight-bold text-dark mb-0">📝 Định nghĩa Ca kiểm thử (Testcase Definition):</h6>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearTestInputs" title="Xóa nội dung testcode và output kỳ vọng để nhập ca mới (vẫn giữ nguyên code của bạn)">
                        🧹 Nhập testcase mới (Xóa input/output)
                    </button>
                </div>
                <div class="row">
                    <div class="col-md-6 form-group">
                        <label for="test_input"><strong>Test Code (Lệnh gọi hàm kiểm thử):</strong></label>
                        <textarea class="form-control font-monospace" id="test_input" name="test_input" rows="3" required placeholder="Ví dụ: print(tinh_tong(10))" style="font-family: Consolas, monospace;">{{last_test_input}}</textarea>
                    </div>
                    <div class="col-md-6 form-group">
                        <label for="predicted_output"><strong>Expected Output (Kết quả bạn kỳ vọng in ra):</strong></label>
                        <textarea class="form-control font-monospace" id="predicted_output" name="predicted_output" rows="3" required placeholder="Ví dụ: 55" style="font-family: Consolas, monospace;">{{last_predicted_output}}</textarea>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 form-group">
                        <label for="category">Phân loại ca kiểm thử:</label>
                        <select class="form-control" id="category" name="category">
                            {{#categories}}
                            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                            {{/categories}}
                        </select>
                    </div>
                    <div class="col-md-8 form-group">
                        <label for="purpose">Mục đích kiểm thử (Giải thích lý do bạn thiết kế test này):</label>
                        <input class="form-control" id="purpose" name="purpose" maxlength="1000" value="{{last_purpose}}" placeholder="Ví dụ: Kiểm tra trường hợp số nguyên dương lớn n=10">
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <button class="btn btn-primary font-weight-bold px-4 py-2 shadow-sm" type="submit">
                    ▶️ Chạy Thử Nghiệm Vi Sai (Run Test)
                </button>
                <small class="text-muted">Hệ thống sẽ chạy song song trên Code của bạn và Solution của Thầy/Cô</small>
            </div>
        </form>
        {{/has_questions}}
    </div>
</div>
{{/can_run}}
{{! Personal Rank & Stats Banner }}
<div class="card bg-light border-primary mb-4 shadow-sm">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <div class="d-flex align-items-center mb-2 mb-md-0">
                <span class="display-4 mr-3" style="font-size: 2.2rem;">🏆</span>
                <div>
                    <h5 class="mb-1 text-primary font-weight-bold">{{#str}} leaderboard, local_testcase_exchange {{/str}} - {{current_course_shortname}}</h5>
                    <div class="text-muted small">
                        {{#has_leaderboard}}
                        🥇 <strong>{{#str}} rank_1, local_testcase_exchange {{/str}}:</strong> {{top_user_name}} (<span class="text-warning font-weight-bold">{{top_stars}} ⭐</span> | {{top_count}} testcases)
                        {{/has_leaderboard}}
                        {{^has_leaderboard}}
                        <em>{{#str}} no_leaderboard_yet, local_testcase_exchange {{/str}}</em>
                        {{/has_leaderboard}}
                    </div>
                </div>
            </div>
            <div class="text-md-right">
                <div class="h5 mb-0">
                    <span class="badge badge-primary p-2">
                        👤 {{#str}} your_rank, local_testcase_exchange {{/str}}: <strong>{{#my_rank}}#{{my_rank}}{{/my_rank}}{{^my_rank}}—{{/my_rank}}</strong>
                    </span>
                    <span class="badge badge-warning text-dark p-2 ml-1">
                        {{my_stars}} ⭐
                    </span>
                    <span class="badge badge-info p-2 ml-1">
                        {{my_count}} testcases
                    </span>
                </div>
                {{#has_unclaimed_rewards}}
                <div class="mt-2">
                    <a href="#rewards" data-toggle="tab" class="badge badge-danger p-2 animate-pulse text-white">
                        🎁 {{#str}} unclaimed_rewards_alert, local_testcase_exchange {{/str}}: <strong>{{unclaimed_rewards_count}}</strong>
                    </a>
                </div>
                {{/has_unclaimed_rewards}}
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs" role="tablist">
    {{#is_teacher}}
    <li class="nav-item"><a class="nav-link active font-weight-bold" data-toggle="tab" href="#course_contributions">{{#str}} coursecontributions, local_testcase_exchange {{/str}} ({{course_contribution_count}})</a></li>
    {{/is_teacher}}
    <li class="nav-item"><a class="nav-link {{^is_teacher}}active{{/is_teacher}}" data-toggle="tab" href="#runs">{{#str}} myruns, local_testcase_exchange {{/str}} ({{run_count}})</a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#contributions">{{#str}} mycontributions, local_testcase_exchange {{/str}} ({{contribution_count}})</a></li>
    <li class="nav-item">
        <a class="nav-link position-relative" data-toggle="tab" href="#rewards">
            {{#str}} myrewards, local_testcase_exchange {{/str}} ({{reward_count}})
            {{#has_unclaimed_rewards}}
            <span class="badge badge-danger ml-1">{{unclaimed_rewards_count}}</span>
            {{/has_unclaimed_rewards}}
        </a>
    </li>
    <li class="nav-item"><a class="nav-link font-weight-bold text-dark" data-toggle="tab" href="#leaderboard">🏆 {{#str}} leaderboard, local_testcase_exchange {{/str}}</a></li>
</ul>
<div class="tab-content border border-top-0 p-3 mb-4">
    {{#is_teacher}}
    <div class="tab-pane active" id="course_contributions">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">{{#str}} coursecontributions, local_testcase_exchange {{/str}}</h5>
            {{#can_review}}<a class="btn btn-sm btn-primary" href="{{review_url}}">{{#str}} reviewcontributions, local_testcase_exchange {{/str}} &rarr;</a>{{/can_review}}
        </div>
        <div class="table-responsive"><table class="table table-sm table-striped table-hover"><thead><tr><th>ID</th><th>{{#str}} student, local_testcase_exchange {{/str}}</th><th>{{#str}} quizquestion, local_testcase_exchange {{/str}}</th><th>{{#str}} testinput, local_testcase_exchange {{/str}}</th><th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} status {{/str}}</th><th>{{#str}} time {{/str}}</th></tr></thead><tbody>
        {{^has_course_contributions}}<tr><td colspan="8" class="text-center text-muted py-3">{{#str}} nocontributionsfound, local_testcase_exchange {{/str}}</td></tr>{{/has_course_contributions}}
        {{#course_contributions}}<tr><td><strong>#{{id}}</strong></td><td><div><strong>{{student_name}}</strong></div><small class="text-muted">{{student_username}}</small></td><td><div><strong>{{quiz_name}}</strong></div><small class="text-muted">{{question_name}}</small></td><td><pre class="mb-0">{{input_normalized}}</pre></td><td><pre class="mb-0">{{oracle_output}}</pre></td><td><span class="badge badge-info">{{category}}</span>{{#purpose}}<br><small class="text-muted">{{purpose}}</small>{{/purpose}}</td><td><span class="{{status_badge_class}}">{{status_label}}</span>{{#has_rating}}<div class="mt-1" title="{{rating_val}}/5 sao"><span class="text-warning font-weight-bold">{{stars_emoji}}</span> <small class="badge badge-warning text-dark">{{rating_val}}/5 ★</small></div>{{/has_rating}}{{#has_teacher_comment}}<div class="small text-muted mt-1 bg-light p-1 rounded border">💬 {{teacher_comment}}</div>{{/has_teacher_comment}}</td><td><small>{{submitted_at}}</small></td></tr>{{/course_contributions}}
        </tbody></table></div>
    </div>
    {{/is_teacher}}
    <div class="tab-pane {{^is_teacher}}active{{/is_teacher}}" id="runs">
        <div class="table-responsive">
            <table class="table table-sm table-bordered table-hover">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th style="width: 140px;">Phiên bản & Thời gian</th>
                        <th>Test Code (Input)</th>
                        <th>Kỳ vọng (Expected)</th>
                        <th>Code của bạn in ra (Got)</th>
                        <th style="width: 150px;">Thẩm định Solution</th>
                        <th style="width: 130px;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    {{^runs}}
                    <tr><td colspan="7" class="text-center text-muted py-3">Chưa có lượt chạy thử nghiệm nào. Hãy dán code và nhập testcase ở trên để chạy thử!</td></tr>
                    {{/runs}}
                    {{#runs}}
                    <tr>
                        <td><strong>#{{id}}</strong></td>
                        <td>
                            {{#has_revision}}
                            <span class="badge badge-info p-1 font-weight-bold">{{revision_badge}}</span>
                            {{/has_revision}}
                            {{^has_revision}}
                            <span class="badge badge-light border text-muted p-1">Lần chạy đơn</span>
                            {{/has_revision}}
                            <div class="small text-muted mt-1" style="font-size: 0.78rem;">{{created_at_formatted}}</div>
                            {{#has_code_snapshot}}
                            <button type="button" class="btn btn-outline-secondary btn-xs py-0 px-1 mt-1 btn-load-run-code" style="font-size: 0.75rem;" title="Nạp code của lượt chạy này vào khung soạn thảo">📋 Nạp code</button>
                            <textarea class="d-none run-code-content">{{student_code_snapshot}}</textarea>
                            {{/has_code_snapshot}}
                        </td>
                        <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{input_raw}}</pre></td>
                        <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{predicted_output}}</pre></td>
                        <td>
                            <pre class="mb-1 font-monospace p-1 border rounded {{#student_matches_expected}}bg-success text-white{{/student_matches_expected}}{{#student_differs_expected}}bg-danger text-white{{/student_differs_expected}}">{{student_run_output}}</pre>
                            {{#student_matches_expected}}<span class="badge badge-success">✓ Khớp kỳ vọng</span>{{/student_matches_expected}}
                            {{#student_differs_expected}}<span class="badge badge-danger">❌ Lệch kỳ vọng</span>{{/student_differs_expected}}
                            <small class="text-muted d-block mt-1">Status: {{student_outcome}}</small>
                        </td>
                        <td>
                            {{#oracle_valid}}
                            <span class="badge badge-success p-2 d-block text-wrap">✓ ĐÚNG CHUẨN ĐỀ</span>
                            {{/oracle_valid}}
                            {{^oracle_valid}}
                            <span class="badge badge-danger p-2 d-block text-wrap">❌ SAI QUY ƯỚC</span>
                            {{/oracle_valid}}
                            {{#show_oracle}}
                            <pre class="mb-0 mt-1 small bg-dark text-white p-1 rounded">{{oracle_output}}</pre>
                            {{/show_oracle}}
                            <small class="text-muted d-block mt-1">Oracle: {{oracle_outcome}}</small>
                        </td>
                        <td class="align-middle text-center">
                            {{#can_contribute}}
                            <form method="post" class="m-0">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="contribute">
                                <input type="hidden" name="run_id" value="{{id}}">
                                <button class="btn btn-sm btn-success font-weight-bold shadow-sm" type="submit">
                                    🚀 Đề xuất Đóng góp
                                </button>
                            </form>
                            {{/can_contribute}}
                            {{^can_contribute}}
                            <span class="{{#display_status_class}}{{display_status_class}}{{/display_status_class}}{{^display_status_class}}badge badge-secondary p-1{{/display_status_class}}">{{display_status}}</span>
                            {{/can_contribute}}
                        </td>
                    </tr>
                    {{/runs}}
                </tbody>
            </table>
        </div>
    </div>
    <div class="tab-pane" id="contributions"><div class="table-responsive"><table class="table table-sm table-striped"><thead><tr><th>ID</th><th>Input</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} status {{/str}}</th><th>{{#str}} starrating, local_testcase_exchange {{/str}} / {{#str}} teachercomment, local_testcase_exchange {{/str}}</th><th>{{#str}} time {{/str}}</th></tr></thead><tbody>{{#contributions}}<tr><td>{{id}}</td><td><pre class="mb-0">{{input_normalized}}</pre></td><td>{{category}}</td><td><span class="{{status_badge_class}}">{{status_label}}</span>{{#can_explain}}<form method="post" class="mt-2"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="explain"><input type="hidden" name="contribution_id" value="{{id}}"><input class="form-control form-control-sm mb-1" name="explanation" required><button class="btn btn-sm btn-primary">{{#str}} resubmitexplanation, local_testcase_exchange {{/str}}</button></form>{{/can_explain}}</td><td>{{#has_rating}}<div title="{{rating_val}}/5 sao"><span class="text-warning font-weight-bold">{{stars_emoji}}</span> <span class="badge badge-warning text-dark ml-1">{{rating_val}}/5 ★</span></div>{{/has_rating}}{{^has_rating}}<span class="text-muted small">—</span>{{/has_rating}}{{#has_teacher_comment}}<div class="small text-muted mt-1 bg-light p-1 rounded border">💬 {{teacher_comment}}</div>{{/has_teacher_comment}}</td><td>{{submitted_at}}</td></tr>{{/contributions}}</tbody></table></div></div>
    
    {{! Tab Rewards with Claim Button }}
    <div class="tab-pane" id="rewards">
        <div class="table-responsive">
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Input</th>
                        <th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} category, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} status {{/str}}</th>
                        <th>{{#str}} action {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{^rewards}}
                    <tr><td colspan="6" class="text-center text-muted py-3">{{#str}} norewardsfound, local_testcase_exchange {{/str}}</td></tr>
                    {{/rewards}}
                    {{#rewards}}
                    <tr class="{{^is_claimed_bool}}table-warning font-weight-bold{{/is_claimed_bool}}">
                        <td>#{{id}}</td>
                        <td><pre class="mb-0">{{display_input}}</pre></td>
                        <td><pre class="mb-0">{{display_oracle}}</pre></td>
                        <td><span class="badge badge-secondary">{{category}}</span></td>
                        <td>
                            {{#is_claimed_bool}}
                            <span class="badge badge-success">✓ {{#str}} claimed, local_testcase_exchange {{/str}}</span>
                            <div class="small text-muted">{{claimed_at}}</div>
                            {{/is_claimed_bool}}
                            {{^is_claimed_bool}}
                            <span class="badge badge-warning text-dark">🔒 {{#str}} unclaimed, local_testcase_exchange {{/str}}</span>
                            {{/is_claimed_bool}}
                        </td>
                        <td>
                            {{^is_claimed_bool}}
                            <form method="post" class="d-inline">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="claim_reward">
                                <input type="hidden" name="reward_id" value="{{id}}">
                                <button type="submit" class="btn btn-sm btn-primary font-weight-bold shadow-sm">
                                    🎁 {{#str}} claim_reward_btn, local_testcase_exchange {{/str}}
                                </button>
                            </form>
                            {{/is_claimed_bool}}
                            {{#is_claimed_bool}}
                            <span class="text-success small font-weight-bold">✓ {{#str}} ready_for_check, local_testcase_exchange {{/str}}</span>
                            {{/is_claimed_bool}}
                        </td>
                    </tr>
                    {{/rewards}}
                </tbody>
            </table>
        </div>
    </div>

    {{! Tab Leaderboard }}
    <div class="tab-pane" id="leaderboard">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0 font-weight-bold">🏆 {{#str}} course_leaderboard_title, local_testcase_exchange {{/str}}</h5>
            <small class="text-muted">{{#str}} leaderboard_rules_hint, local_testcase_exchange {{/str}}</small>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-hover table-striped">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 80px;">{{#str}} rank, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} student, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} total_stars, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} approved_testcases, local_testcase_exchange {{/str}}</th>
                        <th>{{#str}} first_contribution, local_testcase_exchange {{/str}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{^has_leaderboard}}
                    <tr><td colspan="5" class="text-center text-muted py-3">{{#str}} no_leaderboard_yet, local_testcase_exchange {{/str}}</td></tr>
                    {{/has_leaderboard}}
                    {{#leaderboard}}
                    <tr class="{{#is_current_user}}table-primary font-weight-bold{{/is_current_user}}">
                        <td><span class="badge {{badge_class}} p-2 font-weight-bold">{{medal}}</span></td>
                        <td>
                            <div><strong>{{fullname}}</strong> {{#is_current_user}}<span class="badge badge-info ml-1">({{#str}} you, core {{/str}})</span>{{/is_current_user}}</div>
                            <small class="text-muted">{{username}}</small>
                        </td>
                        <td>
                            <span class="badge badge-warning text-dark font-weight-bold px-2 py-1" style="font-size: 0.95rem;">
                                {{total_stars}} ⭐
                            </span>
                        </td>
                        <td><span class="badge badge-secondary p-1">{{approved_count}} testcases</span></td>
                        <td><small class="text-muted">{{first_submitted_at}}</small></td>
                    </tr>
                    {{/leaderboard}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
(function() {
    var courseId = '{{course_id}}' || (new URLSearchParams(window.location.search)).get('course') || '0';
    var selectedQuestionVal = '{{selected_question_value}}' || '';
    var questionSelect = document.getElementById('question');
    if (!selectedQuestionVal && questionSelect) {
        selectedQuestionVal = questionSelect.value;
    }

    var codeEl = document.getElementById('student_code');
    var inputEl = document.getElementById('test_input');
    var predictedEl = document.getElementById('predicted_output');
    var categoryEl = document.getElementById('category');
    var purposeEl = document.getElementById('purpose');
    var statusBadge = document.getElementById('storageStatusBadge');

    function getStorageKey(qVal) {
        var q = qVal || (questionSelect ? questionSelect.value : selectedQuestionVal);
        return 'tc_draft_' + courseId + '_' + String(q).replace(/[^a-zA-Z0-9_-]/g, '_');
    }

    function updateStatus(msg, isSuccess) {
        if (!statusBadge) return;
        statusBadge.textContent = msg;
        statusBadge.className = isSuccess ? 'small font-italic text-success ml-2' : 'small font-italic text-muted ml-2';
    }

    function sanitizeMultiline(str) {
        if (!str) return '';
        if (typeof str !== 'string') str = String(str);
        if (str.indexOf('\n') === -1 && str.indexOf('\\n') !== -1) {
            return str.replace(/\\r\\n|\\n|\\r/g, '\n');
        }
        return str;
    }

    // Save draft to localStorage
    function saveDraft() {
        if (!codeEl && !inputEl && !predictedEl) return;
        var key = getStorageKey();
        var data = {
            code: codeEl ? sanitizeMultiline(codeEl.value) : '',
            input: inputEl ? sanitizeMultiline(inputEl.value) : '',
            predicted: predictedEl ? sanitizeMultiline(predictedEl.value) : '',
            category: categoryEl ? categoryEl.value : 'normal',
            purpose: purposeEl ? purposeEl.value : '',
            updated_at: new Date().toLocaleTimeString()
        };
        try {
            localStorage.setItem(key, JSON.stringify(data));
            updateStatus('💾 Đã lưu nháp tự động lúc ' + data.updated_at, true);
        } catch (e) {
            console.warn('LocalStorage error', e);
        }
    }

    // Restore draft from localStorage
    function restoreDraft() {
        // Clean current values in DOM if they contain literal \n
        if (codeEl) codeEl.value = sanitizeMultiline(codeEl.value);
        if (inputEl) inputEl.value = sanitizeMultiline(inputEl.value);
        if (predictedEl) predictedEl.value = sanitizeMultiline(predictedEl.value);

        var key = getStorageKey();
        try {
            var raw = localStorage.getItem(key);
            if (!raw) return;
            var data = JSON.parse(raw);
            if (!data) return;

            var restored = false;
            var savedCode = sanitizeMultiline(data.code);
            var savedInput = sanitizeMultiline(data.input);
            var savedPredicted = sanitizeMultiline(data.predicted);

            // Restore code if currently empty or has bad literal \n
            if (codeEl && (!codeEl.value.trim() || codeEl.value.indexOf('\\n') !== -1) && savedCode && savedCode.trim()) {
                codeEl.value = savedCode;
                restored = true;
            }
            // Restore test_input if currently empty or has bad literal \n
            if (inputEl && (!inputEl.value.trim() || inputEl.value.indexOf('\\n') !== -1) && savedInput && savedInput.trim()) {
                inputEl.value = savedInput;
                restored = true;
            }
            // Restore predicted_output if currently empty
            if (predictedEl && (!predictedEl.value.trim() || predictedEl.value.indexOf('\\n') !== -1) && savedPredicted && savedPredicted.trim()) {
                predictedEl.value = savedPredicted;
                restored = true;
            }
            if (purposeEl && !purposeEl.value.trim() && data.purpose) {
                purposeEl.value = data.purpose;
            }
            if (categoryEl && data.category && (!categoryEl.value || categoryEl.value === 'normal')) {
                categoryEl.value = data.category;
            }

            // Immediately save clean newlines back to localStorage
            saveDraft();

            if (restored) {
                updateStatus('✓ Đã khôi phục bản nháp từ trình duyệt (' + (data.updated_at || 'trước đó') + ')', true);
            }
        } catch (e) {
            console.warn('LocalStorage error', e);
        }
    }

    // Debounced listener on inputs
    var saveTimer = null;
    function queueSave() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(saveDraft, 400);
    }

    if (codeEl) codeEl.addEventListener('input', queueSave);
    if (inputEl) inputEl.addEventListener('input', queueSave);
    if (predictedEl) predictedEl.addEventListener('input', queueSave);
    if (purposeEl) purposeEl.addEventListener('input', queueSave);
    if (categoryEl) categoryEl.addEventListener('change', queueSave);

    // Save immediately on form submit
    var allForms = document.querySelectorAll('form');
    allForms.forEach(function(f) {
        var actionInput = f.querySelector('input[name="action"][value="run"]');
        if (actionInput) {
            f.addEventListener('submit', function() {
                saveDraft();
            });
        }
    });

    // Handle question select change: save current, then switch URL
    if (questionSelect) {
        questionSelect.addEventListener('change', function() {
            saveDraft();
            var newQ = this.value;
            if (newQ) {
                var url = new URL(window.location.href);
                url.searchParams.set('question', newQ);
                window.location.href = url.toString();
            }
        });
    }

    // Handle "Nạp code" from Revisions list
    document.querySelectorAll('.btn-apply-revision').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var container = this.closest('.list-group-item') || this.parentElement;
            var ta = container.querySelector('.revision-full-code');
            if (ta && codeEl) {
                codeEl.value = sanitizeMultiline(ta.value);
                saveDraft();
                codeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                codeEl.focus();
                updateStatus('✓ Đã nạp code từ phiên bản vào khung soạn thảo!', true);
            }
        });
    });

    // Handle "Nạp code" from Runs table
    document.querySelectorAll('.btn-load-run-code').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var row = this.closest('tr');
            var ta = row ? row.querySelector('.run-code-content') : null;
            if (ta && codeEl) {
                codeEl.value = sanitizeMultiline(ta.value);
                saveDraft();
                codeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                codeEl.focus();
                updateStatus('✓ Đã nạp code từ lượt chạy vào khung soạn thảo!', true);
            }
        });
    });
                saveDraft();
                codeEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                codeEl.focus();
                updateStatus('✓ Đã nạp code từ lượt chạy vào khung soạn thảo!', true);
            }
        });
    });

    // Button: Clear Testcase inputs only (keep student code)
    var btnClearTest = document.getElementById('btnClearTestInputs');
    if (btnClearTest) {
        btnClearTest.addEventListener('click', function() {
            if (inputEl) inputEl.value = '';
            if (predictedEl) predictedEl.value = '';
            if (purposeEl) purposeEl.value = '';
            saveDraft();
            if (inputEl) inputEl.focus();
            updateStatus('Đã làm sạch ô Test Code và Expected Output để nhập mới.', false);
        });
    }

    // Initial restore on page load
    restoreDraft();
})();
</script>
