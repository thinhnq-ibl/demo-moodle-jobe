{{! ========================================================================= }}
{{! 3. CLIENT-SIDE PERSISTENCE & INTERACTIVITY                                }}
{{! ========================================================================= }}
<script>
(function() {
    var courseId = '{{course_id}}';
    var questionVal = '{{selected_question_value}}';
    var userId = '{{sesskey}}';

    var inputEl = document.getElementById('test_input');
    var predictedEl = document.getElementById('predicted_output');
    var purposeEl = document.getElementById('purpose');
    var categoryEl = document.getElementById('category');
    var statusBadge = document.getElementById('storageStatusBadge');
    var questionSelect = document.getElementById('question');
    var btnSubmitRun = document.getElementById('btnSubmitRunTest');

    function getStorageKey() {
        return 'tce_draft_' + courseId + '_' + questionVal;
    }

    function updateStatus(msg, isSuccess) {
        if (!statusBadge) return;
        statusBadge.textContent = msg;
        statusBadge.className = 'small ' + (isSuccess ? 'text-success font-weight-bold' : 'text-muted font-italic');
    }

    function sanitizeMultiline(val) {
        if (!val) return '';
        return val.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
    }

    function getStr(key, fallback) {
        if (window.M && window.M.util && typeof window.M.util.get_string === 'function') {
            try {
                var res = window.M.util.get_string(key, 'local_testcase_exchange');
                if (res && res.indexOf('[[') === -1) {
                    return res;
                }
            } catch (e) {}
        }
        return fallback;
    }

    function formatTime(d) {
        var h = String(d.getHours()).padStart(2, '0');
        var m = String(d.getMinutes()).padStart(2, '0');
        var s = String(d.getSeconds()).padStart(2, '0');
        return h + ':' + m + ':' + s;
    }

    function saveDraft() {
        var key = getStorageKey();
        var now = new Date();
        var data = {
            input: inputEl ? sanitizeMultiline(inputEl.value) : '',
            predicted: predictedEl ? sanitizeMultiline(predictedEl.value) : '',
            category: categoryEl ? categoryEl.value : 'normal',
            purpose: purposeEl ? purposeEl.value : '',
            updated_at: formatTime(now),
            timestamp: now.getTime()
        };
        try {
            localStorage.setItem(key, JSON.stringify(data));
        } catch (e) {
            console.warn('LocalStorage error', e);
        }
    }

    function restoreDraft() {
        if (inputEl) inputEl.value = sanitizeMultiline(inputEl.value);
        if (predictedEl) predictedEl.value = sanitizeMultiline(predictedEl.value);

        var key = getStorageKey();
        try {
            var raw = localStorage.getItem(key);
            if (!raw) return;
            var data = JSON.parse(raw);
            if (!data) return;

            var restored = false;
            var savedInput = sanitizeMultiline(data.input);
            var savedPredicted = sanitizeMultiline(data.predicted);

            if (inputEl && (!inputEl.value.trim() || inputEl.value.indexOf('\n') !== -1) && savedInput && savedInput.trim()) {
                inputEl.value = savedInput;
                restored = true;
            }
            if (predictedEl && (!predictedEl.value.trim() || predictedEl.value.indexOf('\n') !== -1) && savedPredicted && savedPredicted.trim()) {
                predictedEl.value = savedPredicted;
                restored = true;
            }
            if (purposeEl && !purposeEl.value.trim() && data.purpose) {
                purposeEl.value = data.purpose;
            }
            if (categoryEl && data.category && (!categoryEl.value || categoryEl.value === 'normal')) {
                categoryEl.value = data.category;
            }

            saveDraft();
            if (restored) {
                var tm = data.updated_at || getStr('draft_earlier', 'trước đó');
                var restoredMsg = getStr('draft_restored_device', 'Đã khôi phục bản nháp từ thiết bị này ({$a})').replace('{$a}', tm);
                updateStatus(restoredMsg, true);
            }
        } catch (e) {
            console.warn('LocalStorage error', e);
        }
    }

    var saveTimer = null;
    function queueSave() {
        clearTimeout(saveTimer);
        saveTimer = setTimeout(saveDraft, 400);
    }

    if (inputEl) inputEl.addEventListener('input', queueSave);
    if (predictedEl) predictedEl.addEventListener('input', queueSave);
    if (purposeEl) purposeEl.addEventListener('input', queueSave);
    if (categoryEl) categoryEl.addEventListener('change', queueSave);

    var runForm = document.getElementById('runTestForm');
    if (runForm) {
        runForm.addEventListener('submit', function() {
            saveDraft();
            sessionStorage.setItem('tce_just_ran', '1');
            if (btnSubmitRun) {
                btnSubmitRun.disabled = true;
                btnSubmitRun.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i> ' + getStr('running', 'Đang chạy...');
            }
        });
    }

    if (questionSelect) {
        questionSelect.addEventListener('change', function() {
            saveDraft();
            var newQ = this.value;
            if (newQ) {
                var url = new URL(window.location.href);
                url.searchParams.set('question', newQ);
                var activeTab = document.querySelector('ul.nav-tabs .nav-link.active');
                if (activeTab && activeTab.getAttribute('href') && activeTab.getAttribute('href').startsWith('#')) {
                    url.hash = activeTab.getAttribute('href');
                }
                window.location.href = url.toString();
            }
        });
    }

    // Clear testcase inputs button
    var btnClearTest = document.getElementById('btnClearTestInputs');
    if (btnClearTest) {
        btnClearTest.addEventListener('click', function() {
            if (inputEl) inputEl.value = '';
            if (predictedEl) predictedEl.value = '';
            if (purposeEl) purposeEl.value = '';
            saveDraft();
            if (inputEl) inputEl.focus();
            updateStatus(getStr('testcase_cleared', 'Đã xóa dữ liệu testcase để nhập mới.'), false);
        });
    }

    // Toggle older runs function for both desktop table and mobile cards
    window.toggleOlderRuns = function() {
        var olderRuns = document.querySelectorAll('.tce-older-run');
        var btns = document.querySelectorAll('.btn-toggle-older-runs, #btnToggleOlderRuns');
        var isHidden = true;
        olderRuns.forEach(function(el) {
            if (el.classList.contains('d-none')) {
                el.classList.remove('d-none');
                isHidden = false;
            } else {
                el.classList.add('d-none');
                isHidden = true;
            }
        });
        var count = olderRuns.length;
        if (document.querySelector('.tce-history-desktop-table') && document.querySelector('.tce-mobile-run-card')) {
            count = Math.round(count / 2);
        }
        var showMoreText = getStr('show_more_runs', 'Xem thêm ({$a} lượt chạy cũ hơn)').replace('{$a}', count);
        var hideText = getStr('hide_older_runs', 'Thu gọn lượt chạy cũ');
        btns.forEach(function(btn) {
            btn.innerHTML = isHidden ?
                '<i class="fa fa-chevron-down mr-1"></i>' + showMoreText :
                '<i class="fa fa-chevron-up mr-1"></i>' + hideText;
        });
    };

    // Auto-expand older runs or activate tab if navigating directly via anchor
    function checkHashTarget() {
        if (!window.location.hash) return;
        if (window.location.hash.indexOf('#run-') === 0) {
            var target = document.querySelector(window.location.hash);
            if (target && target.classList.contains('tce-older-run')) {
                var olderRuns = document.querySelectorAll('.tce-older-run');
                olderRuns.forEach(function(el) { el.classList.remove('d-none'); });
                var btns = document.querySelectorAll('.btn-toggle-older-runs, #btnToggleOlderRuns');
                var hideText = getStr('hide_older_runs', 'Thu gọn lượt chạy cũ');
                btns.forEach(function(btn) {
                    btn.innerHTML = '<i class="fa fa-chevron-up mr-1"></i>' + hideText;
                });
            }
        } else if (window.jQuery) {
            var tabTarget = document.querySelector('ul.nav-tabs a[href="' + window.location.hash + '"]');
            if (tabTarget) {
                window.jQuery(tabTarget).tab('show');
            }
        }
    }
    window.addEventListener('hashchange', checkHashTarget);
    setTimeout(checkHashTarget, 200);

    // Sync active tab to URL hash
    if (window.jQuery) {
        window.jQuery('ul.nav-tabs a[data-toggle="tab"]').on('shown.bs.tab', function(e) {
            if (e.target && e.target.getAttribute('href') && e.target.getAttribute('href').startsWith('#')) {
                history.replaceState(null, null, e.target.getAttribute('href'));
            }
        });
    }

    // Modal dialog: Return focus to trigger button upon close
    if (window.jQuery) {
        window.jQuery('.modal').on('hidden.bs.modal', function() {
            var id = this.id;
            var trigger = document.querySelector('[data-target="#' + id + '"]');
            if (trigger) {
                trigger.focus();
            }
        });
    }

    // Question prompt mobile initial collapse
    if (window.innerWidth < 768) {
        var promptBody = document.getElementById('questionPromptBody');
        var promptLbl = document.getElementById('lblToggleQuestionPrompt');
        if (promptBody && window.jQuery) {
            window.jQuery(promptBody).collapse('hide');
            if (promptLbl) promptLbl.textContent = getStr('expand', 'Mở rộng');
        }
    }

    // Question prompt toggle text update
    if (window.jQuery) {
        window.jQuery('#questionPromptBody').on('show.bs.collapse', function() {
            var lbl = document.getElementById('lblToggleQuestionPrompt');
            if (lbl) lbl.textContent = getStr('collapse', 'Thu gọn');
        }).on('hide.bs.collapse', function() {
            var lbl = document.getElementById('lblToggleQuestionPrompt');
            if (lbl) lbl.textContent = getStr('expand', 'Mở rộng');
        });
    }

    // After a new run, bring its row in the history into view.
    var shouldRevealLatest = sessionStorage.getItem('tce_just_ran') === '1';
    var latestRunId = '{{latest_run.id}}';
    var latestHistoryRow = latestRunId ? document.getElementById('run-' + latestRunId) : null;
    if (latestHistoryRow && shouldRevealLatest) {
        sessionStorage.removeItem('tce_just_ran');
        window.requestAnimationFrame(function() {
            window.setTimeout(function() {
                latestHistoryRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                latestHistoryRow.focus({ preventScroll: true });
                latestHistoryRow.classList.add('tce-result-reveal-row');

                window.setTimeout(function() {
                    latestHistoryRow.classList.remove('tce-result-reveal-row');
                }, 2200);
            }, 180);
        });
    }

    restoreDraft();

    // Helper to transfer input from Seed Bank / Duplicate Checker into Tab 1 Solve
    window.applyInputToSolve = function(text) {
        if (!text) return;
        var inp = document.getElementById('test_input');
        if (inp) {
            inp.value = text;
            inp.dispatchEvent(new Event('input', { bubbles: true }));
        }
        var tabLink = document.querySelector('a[href="#student_solve"]');
        if (tabLink) {
            tabLink.click();
        }
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Duplicate Checker & Search for Tab 4: Seed Search
    (function() {
        var searchInput = document.getElementById('tceDuplicateSearchInput');
        var btnCheck = document.getElementById('btnCheckDuplicate');
        var btnClear = document.getElementById('btnClearSearchInput');
        var resContainer = document.getElementById('tceDuplicateResultContainer');

        function checkDuplicate() {
            if (!searchInput || !resContainer) return;
            var val = searchInput.value.trim();
            if (!val) {
                resContainer.style.display = 'none';
                resContainer.innerHTML = '';
                document.querySelectorAll('.tce-seed-row, .tce-peer-row').forEach(function(r) {
                    r.style.display = '';
                    r.classList.remove('table-danger');
                });
                return;
            }

            var rawJson = document.getElementById('tceAllKnownInputsData');
            var knownInputs = [];
            if (rawJson) {
                try {
                    knownInputs = JSON.parse(rawJson.textContent || '[]');
                } catch (e) {
                    knownInputs = [];
                }
            }

            var normVal = val.replace(/\r\n/g, '\n').trim();

            // Match check
            var matched = null;
            for (var i = 0; i < knownInputs.length; i++) {
                var itemNorm = (knownInputs[i].input_normalized || knownInputs[i].input || '').replace(/\r\n/g, '\n').trim();
                if (itemNorm === normVal) {
                    matched = knownInputs[i];
                    break;
                }
            }

            // Filter table rows
            document.querySelectorAll('.tce-seed-row, .tce-peer-row').forEach(function(r) {
                var rowInput = (r.getAttribute('data-input') || '').trim();
                var matchesSub = rowInput.toLowerCase().indexOf(normVal.toLowerCase()) !== -1;
                var isExact = (rowInput === normVal);
                if (matchesSub || isExact) {
                    r.style.display = '';
                } else {
                    r.style.display = 'none';
                }
                if (isExact) {
                    r.classList.add('table-danger');
                } else {
                    r.classList.remove('table-danger');
                }
            });

            resContainer.style.display = 'block';
            if (matched) {
                resContainer.innerHTML = '<div class="alert alert-danger border shadow-sm p-3 mb-0" style="border-left: 4px solid #dc3545 !important;">' +
                    '<div class="d-flex align-items-start">' +
                    '<i class="fa fa-exclamation-triangle fa-2x text-danger mr-3 mt-1"></i>' +
                    '<div class="flex-grow-1">' +
                    '<h6 class="font-weight-bold text-danger mb-1">' +
                    '<i class="fa fa-times-circle mr-1"></i>PHÁT HIỆN TRÙNG LẶP (100% TRÙNG KHỚP)!' +
                    '</h6>' +
                    '<div class="small text-dark">' +
                    'Dữ liệu đầu vào này <strong>đã tồn tại trong hệ thống</strong> (<span class="badge ' + matched.badge_class + ' text-white">' + matched.source_label + ' #' + matched.id + '</span> &bull; Phân loại: <strong>' + (matched.category_label || 'Thông thường') + '</strong>).' +
                    '</div>' +
                    '<div class="small text-muted mt-1">' +
                    '⚠️ <em>Lưu ý: Nếu bạn nộp đề xuất với input này, hệ thống sẽ tự động báo trùng lặp. Vui lòng thiết kế ca kiểm thử khác độc đáo hơn!</em>' +
                    '</div>' +
                    '</div></div></div>';
            } else {
                resContainer.innerHTML = '<div class="alert alert-success border shadow-sm p-3 mb-0" style="border-left: 4px solid #28a745 !important;">' +
                    '<div class="d-flex align-items-center justify-content-between flex-wrap" style="gap: 10px;">' +
                    '<div class="d-flex align-items-center">' +
                    '<i class="fa fa-check-circle fa-2x text-success mr-3"></i>' +
                    '<div>' +
                    '<h6 class="font-weight-bold text-success mb-1">' +
                    '<i class="fa fa-check mr-1"></i>INPUT CHƯA TỒN TẠI (HOÀN TOÀN MỚI LẠ)!' +
                    '</h6>' +
                    '<div class="small text-dark">' +
                    'Chưa có ai (cả Thầy/Cô và Bạn học) sử dụng dữ liệu đầu vào này trong hệ thống.' +
                    '</div>' +
                    '<div class="small text-muted mt-1">' +
                    '💡 <em>Testcase này có tính mới cao và có tiềm năng lớn được duyệt nhận sao thưởng!</em>' +
                    '</div>' +
                    '</div></div>' +
                    '<button type="button" class="btn btn-success font-weight-bold btn-sm shadow-sm" onclick="window.applyInputToSolve(document.getElementById(\'tceDuplicateSearchInput\').value)">' +
                    '<i class="fa fa-flask mr-1"></i>Đưa vào Thử nghiệm ngay' +
                    '</button>' +
                    '</div></div>';
            }
        }

        if (btnCheck) {
            btnCheck.addEventListener('click', checkDuplicate);
        }
        if (searchInput) {
            var searchDebounce = null;
            searchInput.addEventListener('input', function() {
                clearTimeout(searchDebounce);
                searchDebounce = setTimeout(checkDuplicate, 250);
            });
        }
        if (btnClear) {
            btnClear.addEventListener('click', function() {
                if (searchInput) searchInput.value = '';
                checkDuplicate();
                if (searchInput) searchInput.focus();
            });
        }
    })();
})();
</script>

</div>
<!-- end .local-testcase-exchange-root -->
