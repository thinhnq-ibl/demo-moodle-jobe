                                <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{predicted_output}}</pre></td>
                                <td><pre class="mb-0 font-monospace bg-light p-1 rounded border">{{oracle_output}}</pre></td>
                                <td>
                                    {{#has_rating}}<span class="badge badge-warning text-dark">{{rating_val}} ⭐</span>{{/has_rating}}
                                    {{^has_rating}}<span class="text-muted small">—</span>{{/has_rating}}
