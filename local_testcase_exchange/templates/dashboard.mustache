{{! Student and teacher dashboard for private runs, contributions and rewards. }}
{{#show_course_switcher}}
<div class="card bg-light mb-3 p-2">
    <div class="d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <span class="text-muted mr-1">📚 {{#str}} course {{/str}}:</span>
            <strong>{{current_course_name}}</strong>
            <a href="{{course_hub_url}}" class="badge badge-secondary ml-2">&larr; {{#str}} allcourses, local_testcase_exchange {{/str}}</a>
        </div>
        <div class="d-flex align-items-center mt-1 mt-md-0">
            <label for="switchCourseSelect" class="small text-muted mb-0 mr-2">{{#str}} switchcourse, local_testcase_exchange {{/str}}:</label>
            <select id="switchCourseSelect" class="custom-select custom-select-sm" onchange="if (this.value) window.location.href=this.value;">
                {{#available_courses}}
                <option value="{{switch_url}}" {{#is_current}}selected{{/is_current}}>{{shortname}} - {{fullname}}</option>
                {{/available_courses}}
            </select>
        </div>
    </div>
</div>
{{/show_course_switcher}}

{{#has_return_url}}
<div class="mb-3 d-flex align-items-center">
    <a class="btn btn-outline-secondary font-weight-bold" href="{{return_url}}">
        &larr; {{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}{{#return_quiz_name}}: <strong>{{return_quiz_name}}</strong>{{/return_quiz_name}}
    </a>
</div>
{{/has_return_url}}

{{! ========================================================================= }}
{{! TEACHER MANAGEMENT HUB VIEW                                               }}
{{! ========================================================================= }}
{{#is_teacher_view}}
<div class="card mb-4 border-dark shadow-sm">
    <div class="card-header bg-dark text-white d-flex flex-wrap justify-content-between align-items-center py-3">
        <div>
            <h4 class="mb-0 font-weight-bold">👨‍🏫 {{#str}} teacherview_title, local_testcase_exchange {{/str}}</h4>
            <small class="text-light opacity-75">Quản lý đóng góp, ngân hàng testcase, phân tích dòng thời gian và chính sách kiểm thử</small>
        </div>
        <div class="mt-2 mt-md-0">
            <a class="btn btn-warning font-weight-bold shadow-sm" href="{{preview_mode_url}}">
                👁️ {{#str}} view_as_student, local_testcase_exchange {{/str}}
            </a>
        </div>
    </div>
    <div class="card-body bg-light border-bottom py-2">
        <form method="get" class="form-inline d-flex flex-wrap align-items-center">
            <input type="hidden" name="course" value="{{course_id}}">
            <input type="hidden" name="tab" value="{{#tab_overview_active}}overview{{/tab_overview_active}}{{#tab_review_active}}review{{/tab_review_active}}{{#tab_bank_active}}bank{{/tab_bank_active}}{{#tab_activity_active}}activity{{/tab_activity_active}}{{#tab_policy_active}}policy{{/tab_policy_active}}">
            <label for="teacherQuestionSelect" class="mr-2 font-weight-bold text-dark">🎯 Chọn Bài tập / Câu hỏi:</label>
            <select class="custom-select custom-select-sm mr-3 font-weight-bold" id="teacherQuestionSelect" name="question" onchange="this.form.submit()">
                {{#questions}}
                <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
                {{/questions}}
            </select>
            <span class="badge badge-info p-2">Ngôn ngữ: <strong>{{coderunnertype}}</strong></span>
        </form>
    </div>
</div>

<!-- Teacher Navigation Tabs -->
<ul class="nav nav-tabs font-weight-bold mb-3" role="tablist">
    <li class="nav-item">
        <a class="nav-link {{#tab_overview_active}}active{{/tab_overview_active}}" data-toggle="tab" href="#tab_overview">
            📊 {{#str}} tab_overview, local_testcase_exchange {{/str}}
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{#tab_review_active}}active{{/tab_review_active}}" data-toggle="tab" href="#tab_review">
            📋 {{#str}} tab_review, local_testcase_exchange {{/str}}
            {{#overview_stats.pending_contributions}}
            <span class="badge badge-warning text-dark ml-1">{{overview_stats.pending_contributions}}</span>
            {{/overview_stats.pending_contributions}}
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{#tab_bank_active}}active{{/tab_bank_active}}" data-toggle="tab" href="#tab_bank">
            🏦 {{#str}} tab_bank, local_testcase_exchange {{/str}}
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{#tab_activity_active}}active{{/tab_activity_active}}" data-toggle="tab" href="#tab_activity">
            👥 {{#str}} tab_activity, local_testcase_exchange {{/str}}
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link {{#tab_policy_active}}active{{/tab_policy_active}}" data-toggle="tab" href="#tab_policy">
            ⚙️ {{#str}} tab_policy, local_testcase_exchange {{/str}}
        </a>
    </li>
</ul>

<div class="tab-content border border-top-0 p-3 mb-4 bg-white shadow-sm rounded-bottom">
    <!-- TAB 1: OVERVIEW -->
    <div class="tab-pane {{#tab_overview_active}}active{{/tab_overview_active}}" id="tab_overview">
        <h5 class="font-weight-bold text-dark mb-3">📊 Tổng Quan Hoạt Động & Trạng Thái Hệ Thống</h5>
        
        <div class="row mb-4">
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-left-primary shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Trạng thái Quiz</div>
                        <div class="h5 mb-0 font-weight-bold">
                            {{#overview_stats.is_quiz_enabled}}
                            <span class="badge badge-success">✓ Đang Bật (Enabled)</span>
                            {{/overview_stats.is_quiz_enabled}}
                            {{^overview_stats.is_quiz_enabled}}
                            <span class="badge badge-danger">Tắt (Disabled)</span>
                            {{/overview_stats.is_quiz_enabled}}
                        </div>
                        <small class="text-muted d-block mt-1">{{current_quiz_name}}</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-left-info shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Lượt Chạy Thử (Runs)</div>
                        <div class="h4 mb-0 font-weight-bold text-dark">{{overview_stats.total_runs}}</div>
                        <small class="text-muted">Lần kiểm thử vi sai sinh viên đã thực hiện</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-left-warning shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Đóng Góp Testcase</div>
                        <div class="h4 mb-0 font-weight-bold text-dark">{{overview_stats.total_contributions}}</div>
                        <div class="small mt-1">
                            <span class="badge badge-warning text-dark">{{overview_stats.pending_contributions}} chờ</span>
                            <span class="badge badge-success">{{overview_stats.approved_contributions}} duyệt</span>
                            <span class="badge badge-secondary">{{overview_stats.duplicate_contributions}} trùng</span>
                            <span class="badge badge-danger">{{overview_stats.rejected_contributions}} từ chối</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-sm-6 mb-3">
                <div class="card border-left-success shadow-sm h-100 py-2">
                    <div class="card-body">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Phần Thưởng Đã Cấp</div>
                        <div class="h4 mb-0 font-weight-bold text-dark">{{overview_stats.total_rewards}}</div>
                        <small class="text-muted">Đã nhận: <strong>{{overview_stats.claimed_rewards}}</strong> | Chưa nhận: <strong>{{overview_stats.unclaimed_rewards}}</strong></small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card bg-light border p-3 mb-3">
            <h6 class="font-weight-bold text-dark mb-2">⚡ Lối tắt quản lý:</h6>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-primary btn-sm mr-2 mb-2 font-weight-bold" href="#tab_review" data-toggle="tab">
                    📋 Duyệt {{overview_stats.pending_contributions}} đề xuất đang chờ
                </a>
                <a class="btn btn-outline-success btn-sm mr-2 mb-2 font-weight-bold" href="#tab_bank" data-toggle="tab">
                    🏦 Xem Kho Testcase (Mẫu, Mầm, Bạn học)
                </a>
                <a class="btn btn-outline-info btn-sm mr-2 mb-2 font-weight-bold" href="{{export_activity_csv_url}}">
                    📥 Xuất Timeline hoạt động (CSV)
                </a>
                <a class="btn btn-outline-dark btn-sm mr-2 mb-2 font-weight-bold" href="{{preview_mode_url}}">
                    👁️ Trải nghiệm giao diện như Sinh viên
                </a>
            </div>
        </div>
    </div>

    <!-- TAB 2: REVIEW & CONTRIBUTIONS -->
    <div class="tab-pane {{#tab_review_active}}active{{/tab_review_active}}" id="tab_review">
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
            <div>
                <h5 class="font-weight-bold text-dark mb-1">📋 Duyệt & Thẩm Định Đóng Góp Sinh Viên</h5>
                <small class="text-muted">Thẩm định tính đúng đắn, xếp hạng sao và phản hồi sư phạm cho sinh viên</small>
            </div>
        </div>

        <!-- Filter bar -->
        <div class="card bg-light p-2 mb-3">
            <form method="get" class="form-inline d-flex flex-wrap align-items-center">
                <input type="hidden" name="course" value="{{course_id}}">
                <input type="hidden" name="question" value="{{selected_question_value}}">
                <input type="hidden" name="tab" value="review">

                <label class="mr-2 small font-weight-bold">{{#str}} filter_by_status, local_testcase_exchange {{/str}}:</label>
                <select class="custom-select custom-select-sm mr-3 mb-1" name="review_status" onchange="this.form.submit()">
                    <option value="all" {{#review_status_all}}selected{{/review_status_all}}>Tất cả trạng thái</option>
                    <option value="pending" {{#review_status_pending}}selected{{/review_status_pending}}>Chờ duyệt / Cần giải trình</option>
                    <option value="submitted" {{#review_status_submitted}}selected{{/review_status_submitted}}>Mới nộp (submitted)</option>
                    <option value="approved" {{#review_status_approved}}selected{{/review_status_approved}}>Đã duyệt (approved)</option>
                    <option value="rejected" {{#review_status_rejected}}selected{{/review_status_rejected}}>Đã từ chối (rejected)</option>
                    <option value="duplicate" {{#review_status_duplicate}}selected{{/review_status_duplicate}}>Trùng lặp (duplicate)</option>
                </select>

                <label class="mr-2 small font-weight-bold">{{#str}} filter_by_student, local_testcase_exchange {{/str}}:</label>
                <select class="custom-select custom-select-sm mr-3 mb-1" name="review_student" onchange="this.form.submit()">
                    <option value="0">{{#str}} all_students, local_testcase_exchange {{/str}}</option>
                    {{#review_filter_students}}
                    <option value="{{user_id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/review_filter_students}}
                </select>

                <a class="btn btn-sm btn-outline-secondary mb-1" href="{{PAGE.url}}&tab=review">Đặt lại bộ lọc</a>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-striped table-hover table-bordered">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 50px;">ID</th>
                        <th>Học viên</th>
                        <th>Bài tập & Câu hỏi</th>
                        <th>Đầu vào kiểm thử</th>
                        <th>Kết quả kỳ vọng</th>
                        <th>Thẩm định Oracle</th>
                        <th>Phân loại & Mục đích</th>
                        <th>Trạng thái & Đánh giá</th>
                        <th style="min-width: 250px;">Thao tác Thẩm định</th>
                    </tr>
                </thead>
                <tbody>
                    {{^has_teacher_contributions}}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Không tìm thấy đóng góp nào theo tiêu chí lọc hiện tại.
                        </td>
                    </tr>
                    {{/has_teacher_contributions}}
                    {{#teacher_contributions}}
                    <tr>
                        <td><strong>#{{id}}</strong></td>
                        <td>
                            <div><strong>{{student_name}}</strong></div>
                            <small class="text-muted">{{student_username}}</small>
                        </td>
                        <td>
                            <div><strong>{{quiz_name}}</strong></div>
                            <small class="text-muted">{{question_name}}</small>
                        </td>
                        <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{input_normalized}}</pre></td>
                        <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{predicted_output}}</pre></td>
                        <td>
                            <pre class="mb-0 font-monospace bg-dark text-white p-1 rounded">{{oracle_output}}</pre>
                            <small class="text-muted">Oracle outcome: {{oracle_outcome}}</small>
                        </td>
                        <td>
                            <span class="badge badge-info">{{category}}</span>
                            {{#purpose}}<div class="small text-muted mt-1">{{purpose}}</div>{{/purpose}}
                        </td>
                        <td>
                            <span class="{{status_badge_class}}">{{status_label}}</span>
                            {{#has_rating}}
                            <div class="mt-1" title="{{rating_val}}/5 sao">
                                <span class="text-warning font-weight-bold">{{stars_emoji}}</span>
                                <small class="badge badge-warning text-dark">{{rating_val}}/5 ★</small>
                            </div>
                            {{/has_rating}}
                            {{#has_teacher_comment}}
                            <div class="small text-muted mt-1 bg-light p-1 rounded border">💬 {{teacher_comment}}</div>
                            {{/has_teacher_comment}}
                            <div class="small text-muted mt-1">{{submitted_at}}</div>
                        </td>
                        <td>
                            <form method="post" class="card bg-light p-2 mb-0">
                                <input type="hidden" name="sesskey" value="{{sesskey}}">
                                <input type="hidden" name="action" value="teacher_review">
                                <input type="hidden" name="contribution_id" value="{{id}}">

                                <div class="form-row align-items-center mb-1">
                                    <div class="col-7">
                                        <select class="custom-select custom-select-sm" name="decision" required>
                                            <option value="approved" {{#is_approved}}selected{{/is_approved}}>✓ Duyệt (Approve)</option>
                                            <option value="needs_explanation" {{#is_pending}}selected{{/is_pending}}>⚠️ Cần giải trình</option>
                                            <option value="rejected" {{#is_rejected}}selected{{/is_rejected}}>❌ Từ chối (Reject)</option>
                                        </select>
                                    </div>
                                    <div class="col-5">
                                        <select class="custom-select custom-select-sm" name="rating">
                                            <option value="0">Sao...</option>
                                            <option value="1" {{#is_rating_1}}selected{{/is_rating_1}}>1 ⭐</option>
                                            <option value="2" {{#is_rating_2}}selected{{/is_rating_2}}>2 ⭐⭐</option>
                                            <option value="3" {{#is_rating_3}}selected{{/is_rating_3}}>3 ⭐⭐⭐</option>
                                            <option value="4" {{#is_rating_4}}selected{{/is_rating_4}}>4 ⭐⭐⭐⭐</option>
                                            <option value="5" {{#is_rating_5}}selected{{/is_rating_5}}>5 ⭐⭐⭐⭐⭐</option>
                                        </select>
                                    </div>
                                </div>
                                <input class="form-control form-control-sm mb-1" name="review_note" placeholder="Nhận xét góp ý cho sinh viên..." value="{{teacher_comment}}">
                                <button type="submit" class="btn btn-sm btn-primary font-weight-bold btn-block">
                                    💾 Lưu Đánh Giá
                                </button>
                            </form>
                        </td>
                    </tr>
                    {{/teacher_contributions}}
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 3: TESTCASE BANK (DISTINGUISHING 3 SOURCES) -->
    <div class="tab-pane {{#tab_bank_active}}active{{/tab_bank_active}}" id="tab_bank">
        <div class="mb-3">
            <h5 class="font-weight-bold text-dark mb-1">🏦 Kho Testcase Phân Định 3 Cấp Nguồn</h5>
            <small class="text-muted">Hệ thống phân tách nghiêm ngặt giữa Testcase Mẫu (công khai), Testcase Mầm (dự phòng) và Testcase Đóng góp (bạn học)</small>
        </div>

        <!-- Section 1: Public Samples -->
        <div class="card mb-4 border-info">
            <div class="card-header bg-info text-white d-flex justify-content-between align-items-center py-2">
                <strong>1️⃣ {{#str}} public_samples_title, local_testcase_exchange {{/str}} ({{public_samples_count}} ca)</strong>
                <span class="badge badge-light text-dark">useasexample = 1</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">{{#str}} public_samples_desc, local_testcase_exchange {{/str}}</p>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 50px;">STT</th>
                                <th>Đầu vào kiểm thử</th>
                                <th>Kết quả kỳ vọng</th>
                                <th style="width: 100px;">Điểm</th>
                                <th style="width: 100px;">Hiển thị</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{^has_public_samples}}
                            <tr><td colspan="5" class="text-center text-muted py-2">Câu hỏi hiện tại không có testcase mẫu công khai nào.</td></tr>
                            {{/has_public_samples}}
                            {{#public_samples}}
                            <tr>
                                <td><strong>#{{index}}</strong></td>
                                <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{input}}</pre></td>
                                <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{expected}}</pre></td>
                                <td><span class="badge badge-secondary">{{mark}}</span></td>
                                <td><span class="badge badge-success">{{display}}</span></td>
                            </tr>
                            {{/public_samples}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Section 2: Teacher Seed Bank -->
        <div class="card mb-4 border-warning">
            <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center py-2">
                <strong>2️⃣ {{#str}} seed_bank_title, local_testcase_exchange {{/str}} ({{seed_testcases_count}} ca)</strong>
                <span class="badge badge-dark">Dự phòng trao thưởng ban đầu</span>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">{{#str}} seed_bank_desc, local_testcase_exchange {{/str}}</p>
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-bordered mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th style="width: 50px;">ID</th>
                                <th>Đầu vào kiểm thử</th>
                                <th>Kết quả kỳ vọng</th>
                                <th>Mục đích</th>
                                <th style="width: 120px;">Nguồn</th>
                                <th style="width: 100px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{^has_seed_testcases}}
                            <tr><td colspan="6" class="text-center text-muted py-2">Chưa có testcase hạt giống nào cho câu hỏi này.</td></tr>
                            {{/has_seed_testcases}}
                            {{#seed_testcases}}
                            <tr>
                                <td><strong>#{{id}}</strong></td>
                                <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{#testcode}}{{testcode}}{{/testcode}}{{^testcode}}{{stdin}}{{/testcode}}</pre></td>
                                <td><pre class="mb-0 font-monospace bg-light p-1 border rounded">{{expected_output}}</pre></td>
                                <td><small class="text-muted">{{purpose}}</small></td>
                                <td><span class="badge badge-info">{{source_type}}</span></td>
                                <td>
                                    <form method="post" class="m-0" onsubmit="return confirm('Bạn có chắc muốn xóa testcase hạt giống này?');">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <input type="hidden" name="action" value="delete_seed">
                                        <input type="hidden" name="seed_id" value="{{id}}">
                                        <button class="btn btn-xs btn-outline-danger py-0 px-2" type="submit">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                            {{/seed_testcases}}
                        </tbody>
                    </table>
                </div>

                <!-- Add manual seed form -->
                <div class="card bg-light p-3">
                    <h6 class="font-weight-bold text-dark mb-2">➕ Thêm Testcase Mầm Thủ Công:</h6>
                    <form method="post">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="add_manual_seed">
                        <input type="hidden" name="seed_quiz_id" value="{{quiz_id}}">
                        <input type="hidden" name="seed_question_id" value="{{question_id}}">

                        <div class="form-row">
                            <div class="col-md-5 form-group">
                                <label class="small font-weight-bold">Dữ liệu kiểm thử (Test Code / Input):</label>
                                <textarea class="form-control form-control-sm font-monospace" name="seed_testcode" rows="2" required placeholder="// Lệnh gọi hàm hoặc dữ liệu kiểm thử (Ví dụ: print(...) hoặc test input)"></textarea>
                            </div>
                            <div class="col-md-4 form-group">
                                <label class="small font-weight-bold">Kết quả chuẩn kỳ vọng (Expected Output):</label>
                                <textarea class="form-control form-control-sm font-monospace" name="seed_expected" rows="2" required placeholder="// Kết quả chuẩn kỳ vọng in ra"></textarea>
                            </div>
                            <div class="col-md-3 form-group">
                                <label class="small font-weight-bold">Mục đích kiểm thử:</label>
                                <input class="form-control form-control-sm mb-2" name="seed_purpose" placeholder="Ví dụ: Kiểm tra số âm biên">
                                <button type="submit" class="btn btn-sm btn-warning btn-block font-weight-bold shadow-sm">
                                    Thêm Testcase Mầm
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Section 3: Approved Peer Contributions -->
        <div class="card mb-3 border-success">
            <div class="card-header bg-success text-white d-flex justify-content-between align-items-center py-2">
                <strong>3️⃣ {{#str}} approved_peer_title, local_testcase_exchange {{/str}} ({{approved_peer_testcases_count}} ca)</strong>
