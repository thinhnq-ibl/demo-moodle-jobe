                        <th>{{#str}} student, local_testcase_exchange {{/str}}</th>
                        <th>Email</th>
                        <th class="text-center" style="width: 100px;">Lượt chạy</th>
                        <th class="text-center" style="width: 110px;">Đóng góp</th>
                        <th class="text-center" style="width: 110px;">Được duyệt</th>
                        <th class="text-center" style="width: 110px;">Nhận thưởng</th>
                        <th class="text-center" style="width: 100px;">Tổng sao ⭐</th>
