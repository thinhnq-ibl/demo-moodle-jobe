{{! Contribution review table. }}
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>ID</th><th>{{#str}} userid, local_testcase_exchange {{/str}}</th><th>{{#str}} quizquestion, local_testcase_exchange {{/str}}</th><th>{{#str}} testinput, local_testcase_exchange {{/str}}</th><th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th><th>{{#str}} purpose, local_testcase_exchange {{/str}}</th><th>{{#str}} category, local_testcase_exchange {{/str}}</th><th>{{#str}} review, local_testcase_exchange {{/str}}</th></tr></thead><tbody>
{{^has_items}}<tr><td colspan="8" class="text-center text-muted">{{#str}} nocontributionspending, local_testcase_exchange {{/str}}</td></tr>{{/has_items}}
{{#items}}<tr><td>{{id}}</td><td>{{user_id}}</td><td>{{quiz_question}}</td><td><pre>{{input_normalized}}</pre></td><td><pre>{{oracle_output}}</pre></td><td>{{purpose}}</td><td>{{category}}</td><td><form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="contribution_id" value="{{id}}"><input class="form-control form-control-sm mb-2" name="review_note" placeholder="{{#str}} reviewnote, local_testcase_exchange {{/str}}"><button class="btn btn-sm btn-success" name="decision" value="approved">{{#str}} approvecontribution, local_testcase_exchange {{/str}}</button> <button class="btn btn-sm btn-warning" name="decision" value="needs_explanation">{{#str}} needsexplanation, local_testcase_exchange {{/str}}</button> <button class="btn btn-sm btn-danger" name="decision" value="rejected">{{#str}} rejectcontribution, local_testcase_exchange {{/str}}</button></form></td></tr>{{/items}}
</tbody></table></div>
