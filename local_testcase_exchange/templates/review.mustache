<div class="local-testcase-exchange-root">
{{! Contribution review table and filters for teacher. }}
{{#show_course_switcher}}
<div class="tce-context-bar d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <span class="text-muted mr-1"><i class="fa fa-graduation-cap text-primary mr-1"></i>{{#str}} course {{/str}}:</span>
        <strong>{{current_course_name}}</strong>
        <a href="{{course_hub_url}}" class="badge badge-light border ml-2">&larr; {{#str}} allcourses, local_testcase_exchange {{/str}}</a>
    </div>
    <div class="d-flex align-items-center mt-1 mt-md-0">
        <label for="switchReviewCourseSelect" class="small text-muted mb-0 mr-2 text-nowrap">{{#str}} switchcourse, local_testcase_exchange {{/str}}:</label>
        <select id="switchReviewCourseSelect" class="custom-select custom-select-sm" onchange="if (this.value) window.location.href=this.value;">
            {{#available_courses}}
            <option value="{{switch_url}}" {{#is_current}}selected{{/is_current}}>{{shortname}} - {{fullname}}</option>
            {{/available_courses}}
        </select>
    </div>
</div>
{{/show_course_switcher}}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom">
    <div>
        <h3 class="font-weight-bold text-dark mb-1">
            <i class="fa fa-check-square text-primary mr-2"></i>{{#str}} reviewcontributions, local_testcase_exchange {{/str}}
        </h3>
        <div class="text-muted small">
            <span>{{current_course_name}}</span>
        </div>
    </div>
    <div class="mt-2 mt-md-0 d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm font-weight-bold" href="{{dashboard_url}}">
            <i class="fa fa-arrow-left mr-1"></i>{{#str}} backtodashboard, local_testcase_exchange {{/str}}
        </a>
        {{#has_return_url}}
        <a class="btn btn-outline-secondary btn-sm font-weight-bold" href="{{return_url}}">
            {{#str}} backtocurrentquiz, local_testcase_exchange {{/str}}{{#return_quiz_name}}: <strong>{{return_quiz_name}}</strong>{{/return_quiz_name}}
        </a>
        {{/has_return_url}}
    </div>
</div>

<div class="card mb-3 border-0 bg-light p-2">
    <form method="get" class="form-inline d-flex flex-wrap align-items-center">
        <input type="hidden" name="course" value="{{course_id}}">
        <input type="hidden" name="status" value="{{current_status}}">
        {{#has_question_filter}}
        <label for="filter_question" class="mr-2 mb-2 font-weight-bold small text-dark">
            <i class="fa fa-filter text-muted mr-1"></i>{{#str}} filterbyquestion, local_testcase_exchange {{/str}}:
        </label>
        <select class="custom-select custom-select-sm mr-2 mb-2" id="filter_question" name="question" onchange="this.form.submit()">
            {{#question_options}}
            <option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>
            {{/question_options}}
        </select>
        <button class="btn btn-outline-secondary btn-sm mb-2" type="submit">{{#str}} search, core {{/str}}</button>
        {{/has_question_filter}}
    </form>
</div>

<ul class="nav nav-tabs font-weight-bold mb-3" role="tablist">
    {{#status_tabs}}
    <li class="nav-item">
        <a class="nav-link {{#is_active}}active{{/is_active}}" href="{{url}}">
            {{label}} <span class="badge {{#is_active}}badge-primary{{/is_active}}{{^is_active}}badge-light border{{/is_active}} ml-1">{{count}}</span>
        </a>
    </li>
    {{/status_tabs}}
</ul>

<div class="table-responsive bg-white rounded border p-0 mb-4">
    <table class="table table-hover align-middle mb-0">
        <thead class="bg-light">
            <tr>
                <th style="width: 50px;">ID</th>
                <th style="width: 180px;">{{#str}} student, local_testcase_exchange {{/str}}</th>
                <th>{{#str}} quizquestion, local_testcase_exchange {{/str}}</th>
                <th>{{#str}} testinput, local_testcase_exchange {{/str}}</th>
                <th>{{#str}} oracleoutput, local_testcase_exchange {{/str}}</th>
                <th>{{#str}} purpose, local_testcase_exchange {{/str}}</th>
                <th style="width: 120px;">{{#str}} status {{/str}}</th>
                <th style="min-width: 240px;">{{#str}} actions, local_testcase_exchange {{/str}}</th>
            </tr>
        </thead>
        <tbody>
            {{^has_items}}
            <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                    <div class="mb-2"><i class="fa fa-check-circle-o text-muted" style="font-size: 2.5rem;"></i></div>
                    <p class="mb-0 font-weight-bold">{{#str}} nocontributionsfound, local_testcase_exchange {{/str}}</p>
                </td>
            </tr>
            {{/has_items}}
            {{#items}}
            <tr>
                <td><strong>#{{id}}</strong></td>
                <td>
                    <div class="font-weight-bold">{{student_name}}</div>
                    <small class="text-muted">{{student_username}}</small>
                </td>
                <td>
                    <div class="font-weight-bold">{{quiz_name}}</div>
                    <small class="text-muted">{{question_name}}</small>
                </td>
                <td>
                    <pre class="bg-light p-2 rounded mb-0 text-wrap font-monospace border" style="max-height: 100px; overflow-y: auto;">{{input_normalized}}</pre>
                </td>
                <td>
                    <pre class="bg-light p-2 rounded mb-0 text-wrap font-monospace border" style="max-height: 100px; overflow-y: auto;">{{oracle_output}}</pre>
                </td>
                <td>
                    <div><span class="badge badge-light border">{{category}}</span></div>
                    {{#purpose}}<small class="text-muted d-block mt-1">{{purpose}}</small>{{/purpose}}
                </td>
                <td>
                    <span class="{{status_badge_class}}">{{status_label}}</span>
                    {{#has_rating}}
                    <div class="mt-1" title="{{rating_val}}/5 sao">
                        <span class="badge badge-warning text-dark">{{rating_val}} ⭐</span>
                    </div>
                    {{/has_rating}}
                    {{#has_teacher_comment}}
                    <div class="small bg-light p-1 rounded border mt-1 text-dark" style="max-width: 220px; word-break: break-word;">
                        💬 {{teacher_comment}}
                    </div>
                    {{/has_teacher_comment}}
                    <div class="small text-muted mt-1">{{submitted_at}}</div>
                </td>
                <td>
                    {{#is_pending}}
                    <form method="post" class="border p-2 rounded bg-light">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="contribution_id" value="{{id}}">
                        <div class="form-group mb-2">
                            <label class="small font-weight-bold mb-1 d-block text-muted">{{#str}} starrating, local_testcase_exchange {{/str}}:</label>
                            <select class="custom-select custom-select-sm" name="rating">
                                <option value="0">Chấm sao...</option>
                                <option value="5">⭐⭐⭐⭐⭐ 5 sao - {{#str}} rating_5_desc, local_testcase_exchange {{/str}}</option>
                                <option value="4">⭐⭐⭐⭐ 4 sao - {{#str}} rating_4_desc, local_testcase_exchange {{/str}}</option>
                                <option value="3">⭐⭐⭐ 3 sao - {{#str}} rating_3_desc, local_testcase_exchange {{/str}}</option>
                                <option value="2">⭐⭐ 2 sao - {{#str}} rating_2_desc, local_testcase_exchange {{/str}}</option>
                                <option value="1">⭐ 1 sao - {{#str}} rating_1_desc, local_testcase_exchange {{/str}}</option>
                            </select>
                        </div>
                        <div class="form-group mb-2">
                            <input class="form-control form-control-sm" name="review_note" placeholder="Nhận xét phản hồi cho sinh viên...">
                        </div>
                        <div class="d-flex gap-1" style="gap: 6px;">
                            <button class="btn btn-sm btn-success font-weight-bold flex-grow-1" name="decision" value="approved" title="{{#str}} approvecontribution, local_testcase_exchange {{/str}}">
                                <i class="fa fa-check mr-1"></i>Chấp thuận
                            </button>
                            <button class="btn btn-sm btn-outline-warning text-dark font-weight-bold" name="decision" value="needs_explanation" title="Yêu cầu giải trình thêm">
                                ? Cần giải thích
                            </button>
                            <button class="btn btn-sm btn-outline-danger font-weight-bold" name="decision" value="rejected" title="{{#str}} rejectcontribution, local_testcase_exchange {{/str}}">
                                <i class="fa fa-times mr-1"></i>Từ chối
                            </button>
                        </div>
                    </form>
                    {{/is_pending}}
                    {{^is_pending}}
                    <div class="text-muted small font-italic py-2">
                        Đã xử lý ({{status_label}})
                    </div>
                    {{/is_pending}}
                </td>
            </tr>
            {{/items}}
        </tbody>
    </table>
</div>

</div>
<!-- end .local-testcase-exchange-root -->
