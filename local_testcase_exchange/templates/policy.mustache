{{! Quiz and question policy editor. }}
{{^has_questions}}<div class="alert alert-warning">{{#str}} nocoderunnerquestions, local_testcase_exchange {{/str}}</div>{{/has_questions}}
{{#has_questions}}
<form method="get" class="mb-4"><input type="hidden" name="course" value="{{courseid}}"><label for="question"><strong>{{#str}} selectquestion, local_testcase_exchange {{/str}}</strong></label><select id="question" name="question" class="form-control" onchange="this.form.submit()">{{#questions}}<option value="{{value}}" {{#selected}}selected{{/selected}}>{{label}}</option>{{/questions}}</select></form>
<form method="post"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="question" value="{{selection}}">
<div class="card mb-3"><div class="card-header"><strong>{{#str}} quizpolicy, local_testcase_exchange {{/str}}</strong></div><div class="card-body">
<div class="form-check"><input type="checkbox" class="form-check-input" id="enabled" name="enabled" value="1" {{#enabled}}checked{{/enabled}}><label class="form-check-label" for="enabled">{{#str}} enablefeature, local_testcase_exchange {{/str}}</label></div>
<div class="form-check"><input type="checkbox" class="form-check-input" id="show_oracle_output" name="show_oracle_output" value="1" {{#show_oracle_output}}checked{{/show_oracle_output}}><label class="form-check-label" for="show_oracle_output">{{#str}} showoracle, local_testcase_exchange {{/str}}</label></div>
<div class="form-check mb-3"><input type="checkbox" class="form-check-input" id="leaderboard_enabled" name="leaderboard_enabled" value="1" {{#leaderboard_enabled}}checked{{/leaderboard_enabled}}><label class="form-check-label" for="leaderboard_enabled">{{#str}} enableleaderboard, local_testcase_exchange {{/str}}</label></div>
<label>{{#str}} reviewmode, local_testcase_exchange {{/str}}</label><select class="form-control mb-2" name="review_mode"><option value="teacher" {{#review_teacher}}selected{{/review_teacher}}>{{#str}} reviewmode_teacher, local_testcase_exchange {{/str}}</option><option value="auto" {{#review_auto}}selected{{/review_auto}}>{{#str}} reviewmode_auto, local_testcase_exchange {{/str}}</option></select>
<label>{{#str}} rewardpolicy, local_testcase_exchange {{/str}}</label><select class="form-control mb-2" name="reward_policy"><option value="one_for_one" {{#reward_one_for_one}}selected{{/reward_one_for_one}}>{{#str}} rewardpolicy_oneforone, local_testcase_exchange {{/str}}</option><option value="disabled" {{#reward_disabled}}selected{{/reward_disabled}}>{{#str}} disabled, core {{/str}}</option></select>
<label>{{#str}} runsperminute, local_testcase_exchange {{/str}}</label><input class="form-control mb-2" type="number" min="1" max="120" name="max_runs_per_minute" value="{{max_runs_per_minute}}"><label>{{#str}} maxinputbytes, local_testcase_exchange {{/str}}</label><input class="form-control" type="number" min="64" max="1048576" name="max_input_bytes" value="{{max_input_bytes}}">
</div></div>
<div class="card mb-3"><div class="card-header"><strong>{{#str}} questionpolicy, local_testcase_exchange {{/str}}</strong></div><div class="card-body">
<label>{{#str}} inputmode, local_testcase_exchange {{/str}}</label><select class="form-control mb-2" name="input_mode"><option value="stdin" {{#input_stdin}}selected{{/input_stdin}}>stdin</option><option value="testcode" {{#input_testcode}}selected{{/input_testcode}}>testcode</option><option value="template" {{#input_template}}selected{{/input_template}}>template</option></select>
<label>{{#str}} testcodetemplate, local_testcase_exchange {{/str}}</label><textarea class="form-control mb-2" name="testcode_template" rows="4">{{testcode_template}}</textarea><label>{{#str}} normalization, local_testcase_exchange {{/str}}</label><select class="form-control mb-2" name="normalization_mode"><option value="raw" {{#normalization_raw}}selected{{/normalization_raw}}>raw</option><option value="trim" {{#normalization_trim}}selected{{/normalization_trim}}>trim</option><option value="json" {{#normalization_json}}selected{{/normalization_json}}>json</option></select><label>{{#str}} categories, local_testcase_exchange {{/str}}</label><input class="form-control" name="categories" value="{{categories}}"></div></div>
<button class="btn btn-primary" type="submit">{{#str}} savechanges {{/str}}</button></form>
{{/has_questions}}
