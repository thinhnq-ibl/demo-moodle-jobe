    {
      "dot": "emerald",
      "title": "Decoupled Data Architecture",
      "items": [
        "Moodle LMS stores official student attempts and question bank entries",
        "testcase_store independently tracks seed testcases, student contributions and exchanges",
        "Moodle gradebook is kept clean from intermediate test generation attempts"
